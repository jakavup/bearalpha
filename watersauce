local function refreshPlayerList()
    playerNames = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player then table.insert(playerNames, p.Name) end
    end
    local stillValid = false
    for _, name in ipairs(playerNames) do
        if name == selectedTarget then stillValid = true; break end
    end
    if not stillValid then selectedTarget = playerNames[1] or nil end
    if playerDropdown then
        pcall(function()
            playerDropdown:SetValues(playerNames)
            if selectedTarget then playerDropdown:SetValue(selectedTarget) end
        end)
    end
end

