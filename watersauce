    local AV = { cache = {}, recs = {} }
    local DEFAULT_ANIMS = {
        idle = { "rbxassetid://507766666", "rbxassetid://507766951" },
        walk = { "rbxassetid://507777826" },
        run = { "rbxassetid://507767714" },
        jump = { "rbxassetid://507765000" },
        fall = { "rbxassetid://507767968" },
        climb = { "rbxassetid://507765644" },
        swim = { "rbxassetid://507784897" },
        toolnone = { "rbxassetid://507768375" },
    }

    local function harvestAnims(template, desc)
        local ids = {}
        local function harvest(root)
            for _, holder in ipairs(root:GetDescendants()) do
                if holder:IsA("StringValue") or holder:IsA("Folder") then
                    local key = string.lower(holder.Name)
                    if not ids[key] then
                        local list = {}
                        for _, a in ipairs(holder:GetChildren()) do
                            if a:IsA("Animation") and a.AnimationId ~= "" then list[#list + 1] = a.AnimationId end
                        end
                        if #list > 0 then ids[key] = list end
                    end
                end
            end
        end
        local animate = template:FindFirstChild("Animate")
        if animate then harvest(animate) end
        for prop, key in pairs({
            IdleAnimation = "idle", WalkAnimation = "walk", RunAnimation = "run", JumpAnimation = "jump",
            FallAnimation = "fall", ClimbAnimation = "climb", SwimAnimation = "swim",
        }) do
            local assetId = desc[prop]
            if not ids[key] and assetId and assetId ~= 0 then
                local ok, objs = pcall(function() return game:GetObjects("rbxassetid://" .. assetId) end)
                if ok and objs then
                    for _, o in ipairs(objs) do harvest(o) end
                end
            end
        end
        for key, list in pairs(DEFAULT_ANIMS) do
            if not ids[key] then ids[key] = list end
        end
        return ids
    end

    local function getAvatar(name)
        local key = string.lower(name)
        local entry = AV.cache[key]
        if entry then return entry end
        local okId, userId = pcall(function() return Players:GetUserIdFromNameAsync(name) end)
        if not okId or not userId then return nil, "User not found: " .. name end
        local okDesc, desc = pcall(function() return Players:GetHumanoidDescriptionFromUserId(userId) end)
        if not okDesc or not desc then return nil, "Couldn't load avatar of " .. name end
        local okModel, built = pcall(function() return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15) end)
        if not okModel or not built then return nil, "Couldn't build avatar: " .. tostring(built) end
        built.Archivable = true
        entry = { template = built, anims = harvestAnims(built, desc) }
        AV.cache[key] = entry
        return entry
    end

    local function hideBody(char)
        for _, o in ipairs(char:GetDescendants()) do
            if o:IsA("BasePart") and o.LocalTransparencyModifier ~= 1 and not string.find(o.Name, "^Part_")
                and not o:FindFirstAncestorOfClass("Tool") then
                o.LocalTransparencyModifier = 1
            end
        end
    end

    local function clearRec(rec, keepHidden)
        for _, inst in ipairs(rec.added) do pcall(function() inst:Destroy() end) end
        rec.added = {}
        if rec.grip then
            local g, p0, c0 = rec.grip[1], rec.grip[2], rec.grip[3]
            if g.Parent and p0 and p0.Parent then pcall(function() g.Part0 = p0; g.C0 = c0 end) end
            rec.grip = nil
        end
        rec.puppet, rec.tracks, rec.playing = nil, nil, nil
        local char = rec.player.Character
        if char and not keepHidden then
            for _, o in ipairs(char:GetDescendants()) do
                if o:IsA("BasePart") then pcall(function() o.LocalTransparencyModifier = 0 end) end
            end
        end
    end

    local function buildRec(rec)
        rec.token += 1
        local token = rec.token
        rec.busy = true
        local entry, err = getAvatar(rec.name)
        if token ~= rec.token then return end
        if not entry then
            rec.busy = false
            clearRec(rec)
            Library:Notify(err, 3)
            return
        end
        local char = rec.player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local myRoot = char and (char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5))
        if not (hum and myRoot) or token ~= rec.token then rec.busy = false; return end
        clearRec(rec, true)

        local model = entry.template:Clone()
        local mhrp = model:FindFirstChild("HumanoidRootPart")
        local mhum = model:FindFirstChildOfClass("Humanoid")
        if not (mhrp and mhum) then model:Destroy(); rec.busy = false; return end
        local dy = hum.RigType == Enum.HumanoidRigType.R6 and (-3 + mhum.HipHeight + mhrp.Size.Y / 2) or 0

        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("Script") or d:IsA("LocalScript") then d:Destroy() end
        end
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = false
                d.CanCollide = false
                d.CanTouch = false
                d.CanQuery = false
                d.Massless = true
            end
        end
        mhrp.Transparency = 1
        mhum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        mhum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        mhum.BreakJointsOnDeath = false
        mhum.RequiresNeck = false
        pcall(function() mhum.EvaluateStateMachine = false end)
        mhum.PlatformStand = true

        mhrp.CFrame = myRoot.CFrame * CFrame.new(0, dy, 0)
        local rootWeld = Instance.new("Weld")
        rootWeld.Part0 = myRoot
        rootWeld.Part1 = mhrp
        rootWeld.C0 = CFrame.new(0, dy, 0)
        rootWeld.Parent = mhrp

        model.Name = HttpService:GenerateGUID(false)
        model.Parent = workspace
        rec.added[#rec.added + 1] = model
        task.wait()
        if token ~= rec.token then clearRec(rec); return end

        local animator = mhum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
        animator.Parent = mhum
        local function load(key)
            local list = entry.anims[key]
            local id = list and list[1]
            if not id then return nil end
            local anim = Instance.new("Animation")
            anim.AnimationId = id
            local ok, tr = pcall(function() return animator:LoadAnimation(anim) end)
            if ok and tr then
                tr.Priority = Enum.AnimationPriority.Core
                return tr
            end
            return nil
        end
        local tracks = {}
        tracks.idle = load("idle")
        tracks.walk = load("walk") or load("run")
        tracks.run = load("run") or tracks.walk
        tracks.jump = load("jump")
        tracks.fall = load("fall") or tracks.jump
        tracks.climb = load("climb")
        tracks.swim = load("swim")
        tracks.toolnone = load("toolnone")
        if tracks.toolnone then tracks.toolnone.Priority = Enum.AnimationPriority.Action end

        rec.tracks = tracks
        rec.playing = nil
        rec.puppet = model
        rec.busy = false
    end

    local function play(rec, name, speed)
        local tr = rec.tracks and rec.tracks[name]
        if rec.playing ~= tr then
            if rec.playing then pcall(function() rec.playing:Stop(0.2) end) end
            rec.playing = tr
            if tr then pcall(function() tr:Play(0.2) end) end
        end
        if tr and speed then pcall(function() tr:AdjustSpeed(speed) end) end
    end

    local function syncTool(rec, char)
        local tool = char:FindFirstChildOfClass("Tool")
        local arm = char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand")
        local grip = arm and arm:FindFirstChild("RightGrip")
        local hand = rec.puppet and rec.puppet:FindFirstChild("RightHand")
        if tool and grip and hand and grip:IsA("JointInstance") and grip.Part0 ~= hand then
            rec.grip = { grip, grip.Part0, grip.C0 }
            local att = hand:FindFirstChild("RightGripAttachment")
            grip.Part0 = hand
            grip.C0 = att and att.CFrame or CFrame.new(0, -0.15, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        end
        local tn = rec.tracks and rec.tracks.toolnone
        if tn then
            if tool and not tn.IsPlaying then pcall(function() tn:Play(0.1) end)
            elseif not tool and tn.IsPlaying then pcall(function() tn:Stop(0.1) end) end
        end
        if not tool then rec.grip = nil end
    end

    local function drive(rec, char)
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if not (hum and root) then return end
        local state = hum:GetState()
        local vel = root.AssemblyLinearVelocity
        local flat = Vector3.new(vel.X, 0, vel.Z).Magnitude
        if state == Enum.HumanoidStateType.Climbing then
            play(rec, "climb", math.max(math.abs(vel.Y) / 8, 0.2))
        elseif state == Enum.HumanoidStateType.Swimming then
            play(rec, "swim", 1)
        elseif state == Enum.HumanoidStateType.Jumping or vel.Y > 4 then
            play(rec, "jump", 1)
        elseif state == Enum.HumanoidStateType.Freefall or vel.Y < -6 then
            play(rec, "fall", 1)
        elseif flat > 0.5 then
            if flat > 20 then play(rec, "run", flat / 24) else play(rec, "walk", flat / 16) end
        else
            play(rec, "idle", 1)
        end
    end

    local function setAvatar(p, name)
        local rec = AV.recs[p]
        name = name and string.match(name, "^%s*(.-)%s*$") or ""
        if name == "" then
            if rec then
                rec.token += 1
                for _, c in ipairs(rec.conns) do pcall(function() c:Disconnect() end) end
                clearRec(rec)
                AV.recs[p] = nil
            end
            return
        end
        if not rec then
            rec = { player = p, name = name, token = 0, added = {}, conns = {}, busy = false }
            AV.recs[p] = rec
            rec.conns[#rec.conns + 1] = p.CharacterAdded:Connect(function(char)
                for _, inst in ipairs(rec.added) do pcall(function() inst:Destroy() end) end
                rec.added, rec.puppet, rec.tracks, rec.playing, rec.grip = {}, nil, nil, nil, nil
                rec.busy = true
                hideBody(char)
                local conn
                conn = char.DescendantAdded:Connect(function(d)
                    if AV.recs[p] == rec and d:IsA("BasePart") and not string.find(d.Name, "^Part_")
                        and not d:FindFirstAncestorOfClass("Tool") then
                        d.LocalTransparencyModifier = 1
                    end
                end)
                task.delay(10, function() if conn.Connected then conn:Disconnect() end end)
                char:WaitForChild("HumanoidRootPart", 10)
                if AV.recs[p] == rec then buildRec(rec) end
            end)
        end
        rec.name = name
        task.spawn(buildRec, rec)
    end

    hubConnect(RunService.RenderStepped, function()
