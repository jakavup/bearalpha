local function applyHitboxes()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and (not p.Team or p.Team.Name ~= "Bear") and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if playerHitboxSize > 1 then
                    if not hitboxOrig[hrp] then
                        hitboxOrig[hrp] = { size = hrp.Size, collide = hrp.CanCollide, transparency = hrp.Transparency }
                    end
                    local want = Vector3.new(playerHitboxSize, playerHitboxSize, playerHitboxSize)
                    if hrp.Size ~= want then
                        hrp.Size = want
                        hrp.CanCollide = false
                    end
                elseif hitboxOrig[hrp] then
                    local o = hitboxOrig[hrp]
                    pcall(function()
                        hrp.Size = o.size
                        hrp.CanCollide = o.collide
                        hrp.Transparency = o.transparency
                    end)
                    hitboxOrig[hrp] = nil
                end
            end
        end
    end
    if playerHitboxSize <= 1 then
        for hrp, o in pairs(hitboxOrig) do
            if hrp.Parent then pcall(function() hrp.Size = o.size; hrp.CanCollide = o.collide end) end
        end
        table.clear(hitboxOrig)
    end
end
