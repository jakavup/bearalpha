local solvingPaintings = false
T.grpSunsetPlain = T.tabPuzzles:AddLeftGroupbox("Sunset Plain Puzzles")
local paintingsToggle = T.grpSunsetPlain:AddToggle("SolvePaintings", {
    Text = "Paintings", Default = false,
    Callback = function(v) solvingPaintings = v end,
})
do
    local function finish(msg)
        solvingPaintings = false
        pcall(function() paintingsToggle:SetValue(false) end)
        Library:Notify(msg, 3)
    end

    local function findModelsFolder()
        local map = workspace:FindFirstChild("Map")
        local folder = map and map:FindFirstChild("Painting")
        return folder and folder:FindFirstChild("Models")
    end

    local function isSolved(model)
        local part = model:FindFirstChild("Painting")
        local emitter = part and part:FindFirstChildOfClass("ParticleEmitter")
        return emitter ~= nil and emitter.Enabled
    end

    local function getCDs(model)
        local list = {}
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("ClickDetector") then
                d.MaxActivationDistance = 1e11
                list[#list + 1] = d
            end
        end
        return list
    end

    local function anyPart(inst)
        if inst:IsA("BasePart") then return inst end
        return inst:FindFirstChildWhichIsA("BasePart", true)
    end

    task.spawn(function()
        while hubAlive do
            task.wait(0.1)
            if not solvingPaintings then continue end

            local models = findModelsFolder()
            if not models then finish("Painting puzzle not found."); continue end

            local list = models:GetChildren()
            table.sort(list, function(a, b)
                local na, nb = tonumber(a.Name), tonumber(b.Name)
                if na and nb then return na < nb end
                return a.Name < b.Name
            end)

            local first = list[1] and anyPart(list[1])
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if first and hrp and not nearPart(first) then
                hrp.CFrame = CFrame.new(findSafeSpotNear(first))
                task.wait(0.5)
            end

            local failed = 0
            for _, model in ipairs(list) do
                if not solvingPaintings then break end
                if isSolved(model) then continue end
                local cds = getCDs(model)
                if #cds == 0 then
                    failed += 1
                    continue
                end
                local t0 = tick()
                while solvingPaintings and model.Parent and not isSolved(model) do
                    for _, cd in ipairs(cds) do
                        if cd.Parent then pcall(fireclickdetector, cd, 10) end
                    end
                    task.wait(0.3)
                    if tick() - t0 > 20 then
                        failed += 1
                        break
                    end
                end
            end

            if solvingPaintings then
                finish(failed == 0 and "Paintings solved." or ("Paintings done, " .. failed .. " failed."))
            end
        end
    end)
end

