do
    local ctrl, cfgs, orig = nil, {}, {}

    local function scan()
        if type(getgc) ~= "function" then return end
        ctrl, cfgs = nil, {}
        for _, t in ipairs(getgc(true)) do
            if type(t) == "table" then
                if rawget(t, "CanSprint") ~= nil and rawget(t, "Current") ~= nil then ctrl = t end
                local inc = rawget(t, "Increments")
                if type(inc) == "table" and typeof(rawget(t, "Stamina")) == "NumberRange" and rawget(t, "Rates") ~= nil then
                    cfgs[#cfgs + 1] = t
                    if not orig[t] then orig[t] = { drain = inc[true], regen = inc[false] } end
                end
            end
        end
    end

    applyStaminaPatch = function()
        if infiniteStamina and #cfgs == 0 then scan() end
        for _, cfg in ipairs(cfgs) do
            local o = orig[cfg]
            if o then
                cfg.Increments[true] = infiniteStamina and 0 or o.drain
                cfg.Increments[false] = o.regen
            end
        end
    end

    local function maxStamina()
        local stats = ctrl and rawget(ctrl, "SprintStats")
        local range = type(stats) == "table" and rawget(stats, "Stamina")
        return typeof(range) == "NumberRange" and range.Max or 100
    end

    local lastScan = 0
    hubConnect(RunService.Heartbeat, function()
        if not infiniteStamina then return end
        local cur = ctrl and rawget(ctrl, "Current")
        if not (typeof(cur) == "Instance" and cur:IsA("ValueBase")) then
            if os.clock() - lastScan > 2 then
                lastScan = os.clock()
                scan()
                applyStaminaPatch()
            end
            return
        end
        local m = maxStamina()
        if cur.Value < m then cur.Value = m end
    end)

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            infiniteStamina = false
            applyStaminaPatch()
        end)
    end
end
