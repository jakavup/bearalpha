RunService:BindToRenderStep("Freecam", Enum.RenderPriority.Camera.Value + 2, function(dt)
    if not freecamEnabled then return end
    local mouse  = UserInputService:GetMouseDelta()
    freecamYaw   = freecamYaw   - mouse.X * 0.3
    freecamPitch = math.clamp(freecamPitch - mouse.Y * 0.3, -89, 89)
    local rot = CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)
    local spd = FREECAM_SPEED
              * (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)   and 0.2 or 1)
              * (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 3   or 1)
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + rot.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - rot.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0, 1, 0) end
    if move.Magnitude > 0 then freecamCF = freecamCF + move.Unit * spd * (dt * 60) end
    camera.CFrame = CFrame.new(freecamCF.Position) * rot
end)

hubConnect(RunService.RenderStepped, function(dt)
    local vp    = camera.ViewportSize
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if bigHeadMode then
        local want = Vector3.new(bigHeadSize, bigHeadSize, bigHeadSize)
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            local head = char and char:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                if headOrig[head] == nil then headOrig[head] = head.Size end
                if head.Size ~= want then head.Size = want end
            end
        end
    end

    if spinEnabled and myHrp then
        spinAngle    = (spinAngle + spinSpeed * dt * 60) % 360
        myHrp.CFrame = CFrame.new(myHrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    end

    if seizureMode and myHrp then
        local offset = Vector3.new(
            (math.random() - 0.5) * seizureIntensity,
            (math.random() - 0.5) * seizureIntensity,
            (math.random() - 0.5) * seizureIntensity
        )
        myHrp.CFrame = myHrp.CFrame + offset
    end

    if balloonRGB and balloonEnabled then
        balloonRGBHue = (balloonRGBHue + dt * balloonRGBSpeed) % 1
        for i, m in ipairs(balloonModels) do
            local b = m:FindFirstChildWhichIsA("Part")
            if b then
                local hue = (balloonRGBHue + (i - 1) * (1 / math.max(#balloonModels, 1))) % 1
                b.Color = Color3.fromHSV(hue, 1, 1)
            end
        end
    end

    for p, t in pairs(speedTrackers) do
        if t.bb then t.bb.Enabled = playerSpeedLabels end
        if not t.lbl or not playerSpeedLabels then
            t.lastPos = nil; t.accumTime = 0; t.accumDist = 0; continue
        end
        local char = p.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            t.lastPos = nil; t.accumTime = 0; t.accumDist = 0; continue
        end
        local cur      = hrp.Position
        local grounded = hum:GetState() ~= Enum.HumanoidStateType.Jumping
                      and hum:GetState() ~= Enum.HumanoidStateType.Freefall
        if t.lastPos and grounded then
            local dx = cur.X - t.lastPos.X
            local dz = cur.Z - t.lastPos.Z
            t.accumDist = t.accumDist + math.sqrt(dx*dx + dz*dz)
            t.accumTime = t.accumTime + dt
        end
        t.lastPos = cur
        if t.accumTime >= 0.1 then
            t.lbl.Text  = math.floor(t.accumDist / t.accumTime) .. " u/s"
            t.accumTime = 0
            t.accumDist = 0
        end
    end

    local nearestBearDist = math.huge
    local nearestBearData = nil

    for p, objects in pairs(espObjects) do
        if p == player then continue end
        local char = p.Character
        if not char or not char.Parent then hideESPObjects(objects); continue end
        local hrp      = char:FindFirstChild("HumanoidRootPart")
        local head     = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not head or not humanoid or humanoid.Health <= 0 then hideESPObjects(objects); continue end

        local isBear = p.Team ~= nil and p.Team.Name == "Bear"

        if not espEnabled then
            for _, obj in ipairs({
                objects.topLeft1, objects.topLeft2, objects.topRight1, objects.topRight2,
                objects.botLeft1, objects.botLeft2, objects.botRight1, objects.botRight2,
                objects.tracer, objects.name, objects.distance, objects.healthBg,
                objects.healthBar, objects.bearLine,
            }) do obj.Visible = false end
            continue
        end

        local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then hideESPObjects(objects); continue end

        local screenH, yTop, yBot
