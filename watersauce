        mBtn.Size = UDim2.fromOffset(v and 44 or 64, 44)
    end

    local mConns = {}
    local dragInput, dragStart, startPos, moved
    table.insert(mConns, mBtn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragInput, dragStart, startPos, moved = input, input.Position, mBtn.Position, false
        end
    end))
    table.insert(mConns, UserInputService.InputChanged:Connect(function(input)
        if not dragStart then return end
        if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local d = input.Position - dragStart
        if d.Magnitude > 8 then moved = true end
        if moved then
            mBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end))
    table.insert(mConns, UserInputService.InputEnded:Connect(function(input)
        if not dragStart then return end
        if input ~= dragInput and input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        dragStart = nil
        if not moved then
            if type(Library.Toggled) == "boolean" then shown = Library.Toggled end
            setShown(not shown)
        end
    end))

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            for _, c in ipairs(mConns) do c:Disconnect() end
            mGui:Destroy()
        end)
    end
end

