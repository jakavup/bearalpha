            end
            visLabel.Text = table.concat(rowBuf, "\n")

            if loaded then
                local pct = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)
                local fill = math.floor(pct * BAR_W + 0.5)
                local head = fill < BAR_W and ">" or ""
                progLabel.Text = string.format("[%s%s%s] %s / %s",
                    string.rep("=", math.max(fill - #head, 0)), head, string.rep("-", BAR_W - fill),
                    clock(sound.TimePosition), clock(sound.TimeLength))
            else
                progLabel.Text = "[" .. string.rep("-", BAR_W) .. "] --:-- / --:--"
            end
        end))

        local function Unload()
            if State.dead then return end
            State.dead = true
            State.loadToken += 1
            for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
            pcall(function() sound:Stop() sound:Destroy() end)
            pcall(function() gui:Destroy() end)
            env.__BA_MUSIC = nil
        end

        env.__BA_MUSIC = { Unload = Unload, Run = run }
        gui.Parent = parent
        winScale.Scale = 0.95
        tween(winScale, 0.25, { Scale = 1 })
        for _, t in ipairs(PRESET) do
            State.playlist[#State.playlist + 1] = { id = t.id, name = t.name }
        end
        log("music.exe ready. " .. #State.playlist .. " tracks loaded. type help")
    end

    local function stopMusicPlayer()
        local env = (getgenv and getgenv()) or _G
        if env.__BA_MUSIC and type(env.__BA_MUSIC.Unload) == "function" then
            pcall(env.__BA_MUSIC.Unload)
        end
    end

    grpFun:AddToggle("MusicPlayer", {
        Text = "Music Player + Visualizer", Default = false,
        Callback = function(v)
            if v then
                local ok, err = pcall(startMusicPlayer)
                if not ok then Library:Notify("Music player failed: " .. tostring(err), 4) end
            else
                stopMusicPlayer()
            end
        end,
    })

    if type(Library.OnUnload) == "function" then Library:OnUnload(stopMusicPlayer) end
end

do
    local W = {
        enabled     = false,
        alive       = true,
        webhookUrl  = "",
        username    = "B.A. Hub Watcher",

        settleDelay = 2,
        killRadius  = 25,

        guiName        = "GameUI",
        popupName      = "NotificationCurrencyEarned",
        popupDebounce  = 0.25,
        popupDedupe    = 1,

        sources = {
            mastery = { label = "Mastery", path = "" },
        },

        round       = nil,
        settling    = nil,
        queue       = {},
        sending     = false,
        conns       = {},
        playerConns = {},
        charConns   = {},
        toggle      = nil,

        guiConn     = nil,
        popup       = nil,
        popupSeen   = false,
        popupConns  = {},
        popupToken  = 0,
        lastAmount  = nil,
        lastAt      = 0,
        lastPopup   = nil,
    }

    function W.parseNumberText(text)
        if type(text) ~= "string" then return nil end
        local cleaned = text:gsub(",", "")
        local num = cleaned:match("^%s*(-?%d+%.?%d*)%s*$")
        return num and tonumber(num) or nil
    end

    function W.extractAmount(text)
        if type(text) ~= "string" then return nil end
        local cleaned = text:gsub(",", "")
        local num = cleaned:match("%d+%.?%d*")
        return num and tonumber(num) or nil
    end

    function W.formatNumber(n)
        if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then return "n/a" end
        local sign = n < 0 and "-" or ""
        local a = math.abs(n)
        if a ~= math.floor(a) then return sign .. string.format("%.2f", a) end
        local digits  = string.format("%d", a)
        local grouped = digits:reverse():gsub("(%d%d%d)", "%1,"):reverse()
        grouped = grouped:gsub("^,", "")
        return sign .. grouped
    end

    function W.formatDuration(seconds)
        seconds = math.max(0, math.floor(seconds or 0))
        return string.format("%dm %02ds", math.floor(seconds / 60), seconds % 60)
    end

    function W.isWebhookUrl(url)
        if type(url) ~= "string" then return false end
        return url:match("^https://discord%.com/api/webhooks/%d+/[%w_%-]+") ~= nil
            or url:match("^https://discordapp%.com/api/webhooks/%d+/[%w_%-]+") ~= nil
    end

    function W.describeChange(src)
        if not src.configured then return "not configured" end
        if src.startV == nil or src.endV == nil then
            return "unreadable (" .. tostring(src.err or "no value") .. ")"
        end
        local delta = src.endV - src.startV
        return string.format("%s%s (%s → %s)",
            delta >= 0 and "+" or "", W.formatNumber(delta),
            W.formatNumber(src.startV), W.formatNumber(src.endV))
    end

    function W.describeQuidz(q)
        if not q.seen then return "popup not found" end
        local s = string.format("+%s from %d popup%s", W.formatNumber(q.total), q.events, q.events == 1 and "" or "s")
        if q.unreadable > 0 then s = s .. string.format(" (%d unreadable)", q.unreadable) end
        return s
    end

    function W.buildRoundPayload(report)
        local fields = {}
        local function add(name, value, inline)
            table.insert(fields, { name = name, value = value, inline = inline ~= false })
        end

        add("Duration", W.formatDuration(report.duration))
        add("Team", report.teamEnd)
        add("Survived", report.survived and "yes" or "no")
        add("Quidz", W.describeQuidz(report.quidz), false)
        for _, key in ipairs({ "mastery" }) do
            local s = report.sources[key]
            add(s.label, W.describeChange(s), false)
        end
        add("Kills", string.format("%d (within %d studs)", report.kills, report.killRadius))
        add("Survivor deaths seen as Bear", tostring(report.survivorDeaths))
        add("Your deaths", tostring(report.myDeaths))

        local footer = report.reason
        if report.partial then footer = footer .. " | started mid-round, totals are partial" end

        return {
            username = W.username,
            embeds = {{
                title       = "Round report",
                description = report.displayName,
                color       = 0xF48FB1,
                fields      = fields,
                footer      = { text = footer },
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        }
    end

    function W.buildTestPayload()
        return {
            username = W.username,
            embeds = {{
                title       = "Webhook watcher test",
                description = "Connection works.",
                color       = 0xF48FB1,
                timestamp   = os.date("!%Y-%m-%dT%H:%M:%SZ"),
            }},
        }
    end

    function W.readSource(path)
        if type(path) ~= "string" or path == "" then return nil, "not configured" end
        local ok, v, err = pcall(function()
            local objPath, attr = path:match("^(.-)@(.+)$")
            if not objPath then objPath = path end
            local inst = game
            for seg in objPath:gmatch("[^%.]+") do
                local nextInst
                if seg == "LocalPlayer" and inst == Players then
                    nextInst = player
                else
                    nextInst = inst:FindFirstChild(seg)
                end
                if not nextInst then return nil, "missing: " .. seg end
                inst = nextInst
            end
            if attr then
                local a = inst:GetAttribute(attr)
                if type(a) == "number" then return a end
                return nil, "attribute missing or not a number"
            end
            if inst:IsA("ValueBase") then
                local val = inst.Value
                if type(val) == "number" then return val end
                local n = W.parseNumberText(val)
                if n then return n end
                return nil, "value is not numeric"
            end
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                local n = W.parseNumberText(inst.Text)
                if n then return n end
                return nil, "text is not a plain number"
            end
            return nil, "unsupported instance class " .. inst.ClassName
        end)
        if not ok then return nil, tostring(v) end
        return v, err
    end

    function W.teamName()
        return player.Team and player.Team.Name or "none"
    end

    function W.myHrp()
        local char = player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    function W.isAlive()
        local char = player.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        return hum ~= nil and hum.Health > 0
    end

    function W.popupTexts(inst)
        local texts = {}
        local function consider(o)
            if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Visible and o.Text ~= "" then
                table.insert(texts, o.Text)
            end
        end
        consider(inst)
        for _, d in ipairs(inst:GetDescendants()) do consider(d) end
        return texts
    end

    function W.readPopup()
        local r    = W.round or W.settling
        local inst = W.popup
        if not W.enabled or not r or not inst or not inst.Parent then return end
        if inst:IsA("GuiObject") and not inst.Visible then return end
        local texts = W.popupTexts(inst)
        if #texts == 0 then return end
        W.lastPopup = table.concat(texts, " / ")
        local amount
        for _, text in ipairs(texts) do
            amount = W.extractAmount(text)
            if amount then break end
        end
        if not amount then
            r.quidzUnreadable += 1
            return
        end
        local now = tick()
        if amount == W.lastAmount and now - W.lastAt < W.popupDedupe then return end
        W.lastAmount = amount
        W.lastAt     = now
        r.quidz       += amount
        r.quidzEvents += 1
    end

    function W.schedulePopupRead()
        W.popupToken += 1
        local token = W.popupToken
        task.delay(W.popupDebounce, function()
            if token == W.popupToken and W.alive then W.readPopup() end
        end)
    end

    function W.clearPopupConns()
        for _, c in ipairs(W.popupConns) do c:Disconnect() end
        W.popupConns = {}
    end

    function W.bindPopup(inst, fresh)
        W.clearPopupConns()
        W.popup     = inst
        W.popupSeen = true
        local function track(c) table.insert(W.popupConns, c) end
        local function watchText(o)
            if o:IsA("TextLabel") or o:IsA("TextButton") then
                track(o:GetPropertyChangedSignal("Text"):Connect(W.schedulePopupRead))
            end
        end
        watchText(inst)
        for _, d in ipairs(inst:GetDescendants()) do watchText(d) end
        track(inst.DescendantAdded:Connect(function(d)
            watchText(d)
            W.schedulePopupRead()
        end))
        if inst:IsA("GuiObject") then
            track(inst:GetPropertyChangedSignal("Visible"):Connect(W.schedulePopupRead))
        end
        if fresh then W.schedulePopupRead() end
    end

    function W.bindGui(gui)
        W.clearPopupConns()
        W.popup = nil
        if W.guiConn then W.guiConn:Disconnect(); W.guiConn = nil end
        if not gui then return end
        W.guiConn = gui.ChildAdded:Connect(function(c)
            if c.Name == W.popupName then W.bindPopup(c, true) end
        end)
        local existing = gui:FindFirstChild(W.popupName)
        if existing then W.bindPopup(existing, false) end
    end

    function W.beginRound(partial)
        local r = {
            startedAt       = tick(),
            partial         = partial,
            kills           = 0,
            survivorDeaths  = 0,
            myDeaths        = 0,
            quidz           = 0,
            quidzEvents     = 0,
            quidzUnreadable = 0,
            start           = {},
        }
        for key, src in pairs(W.sources) do
            if src.path ~= "" then
                local v, err = W.readSource(src.path)
                r.start[key] = { v = v, err = err }
            else
                r.start[key] = {}
            end
        end
        W.round = r
    end

    function W.snapshot(r)
        return {
            teamEnd  = W.teamName(),
            alive    = W.isAlive(),
            duration = tick() - r.startedAt,
        }
    end

    function W.finalize(r, reason, snap)
        local report = {
            reason         = reason,
            partial        = r.partial,
            displayName    = player.DisplayName,
            duration       = snap.duration,
            teamEnd        = snap.teamEnd,
            survived       = snap.alive and r.myDeaths == 0,
            kills          = r.kills,
            survivorDeaths = r.survivorDeaths,
            myDeaths       = r.myDeaths,
            killRadius     = W.killRadius,
            quidz = {
                seen       = W.popupSeen,
                total      = r.quidz,
                events     = r.quidzEvents,
                unreadable = r.quidzUnreadable,
            },
            sources        = {},
        }
        for key, src in pairs(W.sources) do
            local configured = src.path ~= ""
            local startEntry = r.start[key] or {}
            local endV, endErr
            if configured then endV, endErr = W.readSource(src.path) end
            report.sources[key] = {
                label      = src.label,
                configured = configured,
                startV     = startEntry.v,
                endV       = endV,
                err        = startEntry.err or endErr,
            }
        end
        return report
    end

    function W.endRound(reason)
        local r = W.round
        if not r then return end
        W.round    = nil
        W.settling = r
        local snap = W.snapshot(r)
        task.delay(W.settleDelay, function()
            if W.settling == r then W.settling = nil end
            if not W.alive then return end
            W.enqueue(W.buildRoundPayload(W.finalize(r, reason, snap)))
        end)
    end

    function W.onDied(p, char)
        local r = W.round
        if not W.enabled or not r then return end
        if p == player then
            r.myDeaths += 1
            return
        end
        if W.teamName() ~= "Bear" then return end
        if not (p.Team and p.Team.Name == "Survivors") then return end
        r.survivorDeaths += 1
        local hrp   = char:FindFirstChild("HumanoidRootPart")
        local mine  = W.myHrp()
        if hrp and mine and (hrp.Position - mine.Position).Magnitude <= W.killRadius then
            r.kills += 1
        end
    end

    function W.watchPlayer(p)
        local function hook(char)
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 5)
                if not hum or not W.alive then return end
                if W.charConns[p] then W.charConns[p]:Disconnect() end
                W.charConns[p] = hum.Died:Connect(function() W.onDied(p, char) end)
            end)
        end
        W.playerConns[p] = p.CharacterAdded:Connect(hook)
        if p.Character then hook(p.Character) end
    end

    function W.unwatchPlayer(p)
        if W.charConns[p]   then W.charConns[p]:Disconnect();   W.charConns[p]   = nil end
        if W.playerConns[p] then W.playerConns[p]:Disconnect(); W.playerConns[p] = nil end
    end

    function W.post(payload)
        local req = (syn and syn.request) or http_request or request
        if not req then return false, "executor exposes no HTTP request function" end
        local ok, res = pcall(req, {
            Url     = W.webhookUrl,
            Method  = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body    = HttpService:JSONEncode(payload),
        })
        if not ok then return false, tostring(res) end
        local status = type(res) == "table" and res.StatusCode or nil
        if status and status >= 200 and status < 300 then return true end
        local retryAfter
        if status == 429 then
            local okJ, body = pcall(function() return HttpService:JSONDecode(res.Body) end)
            retryAfter = okJ and type(body) == "table" and tonumber(body.retry_after) or 1
        end
        return false, "HTTP " .. tostring(status), retryAfter
    end

    function W.pump()
        if W.sending then return end
        W.sending = true
        task.spawn(function()
            while #W.queue > 0 and W.alive do
                local item = table.remove(W.queue, 1)
                local ok, detail, retryAfter
                for _ = 1, 3 do
                    ok, detail, retryAfter = W.post(item)
                    if ok or not retryAfter then break end
                    task.wait(math.clamp(retryAfter, 0.5, 30))
                end
                if not ok then
                    local msg = tostring(detail):gsub("https://%S+", "[url]")
                    Library:Notify("Webhook failed: " .. msg, 4)
                end
            end
            W.sending = false
        end)
    end

    function W.enqueue(payload)
        if #W.queue >= 20 then table.remove(W.queue, 1) end
        table.insert(W.queue, payload)
        W.pump()
    end

    local grp = tabMisc:AddRightGroupbox("Webhook Watcher")

    W.toggle = grp:AddToggle("WebhookWatcher", {
        Text = "Webhook Watcher", Default = false,
        Callback = function(v)
            if v and not W.isWebhookUrl(W.webhookUrl) then
                Library:Notify("Set a valid Discord webhook URL first.", 3)
                if W.toggle then W.toggle:SetValue(false) end
                return
            end
            W.enabled = v
            if v then
                if not W.round and workspace:FindFirstChild("Map") then W.beginRound(true) end
            else
                W.round    = nil
                W.settling = nil
            end
        end,
    })
    grp:AddInput("WebhookUrl", {
        Text = "Discord Webhook URL", Default = "", Finished = true,
        Placeholder = "https://discord.com/api/webhooks/...",
        Callback = function(v) W.webhookUrl = (v or ""):match("^%s*(.-)%s*$") end,
    })
    grp:AddInput("WebhookMasteryPath", {
        Text = "Mastery value path", Default = "", Finished = true,
        Placeholder = "Players.LocalPlayer@Mastery",
        Callback = function(v) W.sources.mastery.path = (v or ""):match("^%s*(.-)%s*$") end,
    })
    grp:AddSlider("WebhookSettle", {
        Text = "Settle Delay (s)", Min = 0, Max = 10, Default = 2, Increment = 0.5,
        Callback = function(v) W.settleDelay = v end,
    })
    grp:AddSlider("WebhookKillRadius", {
        Text = "Kill Attribution Radius", Min = 5, Max = 100, Default = 25,
        Callback = function(v) W.killRadius = v end,
    })
    grp:AddButton({
        Text = "Send Test Message",
        Func = function()
            if not W.isWebhookUrl(W.webhookUrl) then Library:Notify("Set a valid Discord webhook URL first.", 3); return end
            W.enqueue(W.buildTestPayload())
        end,
    })
    grp:AddButton({
        Text = "Send Round Report Now",
        Func = function()
            if not W.isWebhookUrl(W.webhookUrl) then Library:Notify("Set a valid Discord webhook URL first.", 3); return end
            local r = W.round
            if not r then Library:Notify("No round is being tracked.", 3); return end
            W.enqueue(W.buildRoundPayload(W.finalize(r, "manual snapshot", W.snapshot(r))))
        end,
    })
    grp:AddButton({
        Text = "Check Popup & Paths",
        Func = function()
            local parts = {}
            if W.popup and W.popup.Parent then
                table.insert(parts, "Popup bound, last read: " .. tostring(W.lastPopup or "none yet"))
            else
                table.insert(parts, "Popup: not found")
            end
            local m = W.sources.mastery
            local v, err = W.readSource(m.path)
            table.insert(parts, m.label .. ": " .. (v ~= nil and W.formatNumber(v) or tostring(err)))
            Library:Notify(table.concat(parts, " | "), 6)
        end,
    })

    for _, p in ipairs(Players:GetPlayers()) do W.watchPlayer(p) end
    table.insert(W.conns, Players.PlayerAdded:Connect(function(p) W.watchPlayer(p) end))
    table.insert(W.conns, Players.PlayerRemoving:Connect(function(p) W.unwatchPlayer(p) end))

    table.insert(W.conns, workspace.ChildAdded:Connect(function(c)
        if W.enabled and c.Name == "Map" then W.beginRound(false) end
    end))
    table.insert(W.conns, workspace.ChildRemoved:Connect(function(c)
        if W.enabled and c.Name == "Map" then W.endRound("workspace.Map removed") end
    end))

    task.spawn(function()
        local pg = player:WaitForChild("PlayerGui", 10)
        if not pg or not W.alive then return end
        table.insert(W.conns, pg.ChildAdded:Connect(function(c)
            if c.Name == W.guiName then W.bindGui(c) end
        end))
        W.bindGui(pg:FindFirstChild(W.guiName))
    end)

    function W.cleanup()
        W.alive    = false
        W.enabled  = false
        W.round    = nil
        W.settling = nil
        for _, c in ipairs(W.conns) do c:Disconnect() end
        W.conns = {}
        W.clearPopupConns()
        if W.guiConn then W.guiConn:Disconnect(); W.guiConn = nil end
        for p in pairs(W.playerConns) do W.unwatchPlayer(p) end
        for p in pairs(W.charConns)   do W.unwatchPlayer(p) end
    end

    if type(Library.OnUnload) == "function" then Library:OnUnload(W.cleanup) end
end

