local function solveAltar()
    local function root()
        local char = player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end
    local hrp = root()
    if not hrp then return false end
    local ok = pcall(function()
        local altar = workspace:WaitForChild("Map", 10):WaitForChild("CheeseAltar", 10)
        local item = altar:WaitForChild("Items", 10):WaitForChild("Item", 10):WaitForChild("Detect", 10)
        local base = altar:WaitForChild("Base", 10):WaitForChild("Detect", 10)

        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(item.Position) * hrp.CFrame.Rotation
        task.wait(0.3)

        hrp = root()
        if not hrp then return end
        local dist = (hrp.Position - base.Position).Magnitude
        local away = Vector3.new(hrp.Position.X - base.Position.X, 0, hrp.Position.Z - base.Position.Z)
        away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
        local edge = math.max(base.Size.X, base.Size.Z) / 2
        local stop = base.Position + away * (edge + 3)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { player.Character, base }
        local hit = workspace:Raycast(stop + Vector3.new(0, 10, 0), Vector3.new(0, -40, 0), params)
        stop = hit and (hit.Position + Vector3.new(0, 3, 0)) or Vector3.new(stop.X, hrp.Position.Y, stop.Z)
        local flatTarget = Vector3.new(base.Position.X, stop.Y, base.Position.Z)
        local facing = CFrame.lookAt(stop, flatTarget).Rotation
        hrp.CFrame = CFrame.new(hrp.Position) * facing
        local bindName = "BAAltarLook"
        RunService:BindToRenderStep(bindName, Enum.RenderPriority.Camera.Value + 5, function()
            local cam = workspace.CurrentCamera
            if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, base.Position) end
        end)
        local tw = TweenService:Create(hrp, TweenInfo.new(math.clamp((hrp.Position - stop).Magnitude / 80, 0.05, 2), Enum.EasingStyle.Linear),
            { CFrame = CFrame.new(stop) * facing })
        tw:Play()
        tw.Completed:Wait()
        task.wait(0.3)
        pcall(function() RunService:UnbindFromRenderStep(bindName) end)
    end)
    pcall(function() RunService:UnbindFromRenderStep("BAAltarLook") end)
    return ok
end

