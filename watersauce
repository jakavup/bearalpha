local function solveMemoryGame()
    local pg = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 10)
    if not pg then return nil end
    local answer, result, remote, gui
    local conns = {}

    local function listen(r)
        if remote then return end
        remote = r
        conns[#conns + 1] = r.OnClientEvent:Connect(function(action, data)
            if action == "Code" and type(data) == "table" then
                local a = {}
                for i = 1, #data do a[i] = data[i] end
                answer = a
            elseif action == "Result" then
                result = data
            end
        end)
    end

    local function hook(g)
        if g.Name ~= "MemoryQuestion" or gui then return end
        gui = g
        local ev = g:FindFirstChild("Event")
        if ev and ev:IsA("ObjectValue") and ev.Value and ev.Value:IsA("RemoteEvent") then
            listen(ev.Value)
            return
        end
        task.spawn(function()
            local e = g:WaitForChild("Event", 5)
            if not (e and e:IsA("ObjectValue")) then return end
            local t = tick()
            while not e.Value and tick() - t < 5 do task.wait() end
            if e.Value and e.Value:IsA("RemoteEvent") then listen(e.Value) end
        end)
    end

    conns[#conns + 1] = pg.ChildAdded:Connect(hook)
    local existing = pg:FindFirstChild("MemoryQuestion")
    if existing then hook(existing) end

    pcall(function()
        local mem = workspace:WaitForChild("Map", 10):WaitForChild("Memory", 10)
        local d1 = mem:WaitForChild("Item", 10):WaitForChild("Detect", 10)
        if not nearPart(d1, 10) then teleportTo(d1); task.wait(0.5) end
        local d2 = mem:WaitForChild("Base", 10):WaitForChild("Detect", 10)
        if not nearPart(d2, 10) then teleportTo(d2) end
    end)

    local t = tick()
    while not answer and tick() - t < 20 do task.wait(0.1) end

    if answer and remote and gui then
        local frame = gui:FindFirstChild("Frame")
        local send = frame and frame:FindFirstChild("Send")
        t = tick()
        while gui.Parent and not (send and send.Visible) and tick() - t < 10 do task.wait(0.05) end
        if gui.Parent then
            task.wait(0.1)
            pcall(function() remote:FireServer("Code", answer) end)
            if frame then
                pcall(function()
                    frame.Entry.Visible = false
                    frame.Send.Visible = false
                    frame.TopQuestion.Visible = false
                    frame.Prompt.Text = "VERIFYING..."
                    frame.Prompt.Visible = true
                end)
            end
            t = tick()
            while result == nil and gui.Parent and tick() - t < 10 do task.wait(0.1) end
        end
    end

    for _, c in ipairs(conns) do c:Disconnect() end
    return answer ~= nil, result
end

