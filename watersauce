do
    local X = {
        teamCheckMode = "Skip Bears",
        killRadius = 10,
        killauraOn = false,
        killauraToken = 0,
        orbitOn = false,
        orbitDistance = 8,
        orbitSpeed = 1,
        orbitAngle = 0,
        orbitTarget = nil,
        hudLabel = nil,
        candyPriorityOn = false,
        candyCollected = 0,
        candyWindowStart = tick(),
        candyLabel = nil,
        crosshairOn = false,
        noFogOn = false,
        fogOrig = { Start = lighting.FogStart, End = lighting.FogEnd },
        hideOthersAccOn = false,
        hiddenOthersAcc = {},
    }

    local crosshairH = newDrawing("Line", { Thickness = 1.5, Color = Color3.new(1, 1, 1), Visible = false, ZIndex = 10 })
    local crosshairV = newDrawing("Line", { Thickness = 1.5, Color = Color3.new(1, 1, 1), Visible = false, ZIndex = 10 })

    local function myHrp()
        local char = player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function isBear(p)
        return p.Team ~= nil and p.Team.Name == "Bear"
    end

    local function isValidTarget(p)
        if p == player then return false end
        if X.teamCheckMode == "Skip Bears" and isBear(p) then return false end
        if X.teamCheckMode == "Skip Survivors" and not isBear(p) then return false end
        local char = p.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then return false end
        return true
    end

    local function nearestValidTarget()
        local origin = myHrp()
        if not origin then return nil end
        local best, bestDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if isValidTarget(p) then
                local d = (p.Character.HumanoidRootPart.Position - origin.Position).Magnitude
                if d < bestDist then best, bestDist = p, d end
            end
        end
        return best
    end

    local function runKillaura(token)
        while X.killauraOn and X.killauraToken == token do
            local hrp = myHrp()
            if hrp then
                for _, p in ipairs(Players:GetPlayers()) do
                    if not (X.killauraOn and X.killauraToken == token) then break end
                    if isValidTarget(p) then
                        local tHrp = p.Character.HumanoidRootPart
                        if (tHrp.Position - hrp.Position).Magnitude <= X.killRadius then
                            pcall(firetouchinterest, hrp, tHrp, 0)
                            task.wait(0.05)
                            pcall(firetouchinterest, hrp, tHrp, 1)
                        end
                    end
                end
            end
            task.wait(0.5)
        end
    end

    grpCombat:AddDropdown("TeamCheckMode", {
        Text = "Team Check", Values = { "Skip Bears", "Skip Survivors", "None" }, Default = 1,
        Callback = function(v) X.teamCheckMode = v end,
    })
    grpCombat:AddToggle("ExtendedKillaura", {
        Text = "Extended Killaura", Default = false,
        Callback = function(v)
            X.killauraOn = v
            X.killauraToken += 1
            if v then task.spawn(runKillaura, X.killauraToken) end
        end,
    })
    grpCombat:AddSlider("ExtendedKillRadius", {
        Text = "Extended Killaura Radius", Min = 5, Max = 100, Default = 10,
        Callback = function(v) X.killRadius = v end,
    })
    X.hudLabel = grpCombat:AddLabel("Target: none")

    grpTeleport:AddToggle("OrbitTarget", {
        Text = "Orbit / Follow Target", Default = false,
        Callback = function(v)
            X.orbitOn = v
            if v then X.orbitTarget = getRageTarget() end
        end,
    })
    grpTeleport:AddSlider("OrbitDistance", {
        Text = "Orbit Distance", Min = 3, Max = 40, Default = 8,
        Callback = function(v) X.orbitDistance = v end,
    })
    grpTeleport:AddSlider("OrbitSpeed", {
        Text = "Orbit Speed", Min = 0.1, Max = 10, Default = 1, Increment = 0.1,
        Callback = function(v) X.orbitSpeed = v end,
    })

    grpFarming:AddToggle("FarmCandyPriority", {
        Text = "Farm Candy (Highest Value First)", Default = false,
        Callback = function(v) X.candyPriorityOn = v end,
    })
    X.candyLabel = grpFarming:AddLabel("Candy/min: 0")

    grpVisuals:AddToggle("Crosshair", {
        Text = "Custom Crosshair", Default = false,
        Callback = function(v)
            X.crosshairOn = v
            if not v then
                crosshairH.Visible = false
                crosshairV.Visible = false
                UserInputService.MouseIconEnabled = true
            end
        end,
    })
    grpVisuals:AddToggle("NoFog", {
        Text = "No Fog", Default = false,
        Callback = function(v)
            X.noFogOn = v
            if v then
                lighting.FogStart = 0
                lighting.FogEnd = 1000000
            else
                lighting.FogStart = X.fogOrig.Start
                lighting.FogEnd = X.fogOrig.End
            end
        end,
    })
    grpVisualsSettings:AddSlider("TimeOfDay", {
        Text = "Time of Day", Min = 0, Max = 24, Default = 14, Increment = 0.5,
        Callback = function(v) lighting.ClockTime = v end,
    })
    grpVisuals:AddToggle("HideOthersAccessories", {
        Text = "Hide Others' Accessories", Default = false,
        Callback = function(v)
            X.hideOthersAccOn = v
            if not v then
                for _, obj in ipairs(X.hiddenOthersAcc) do
                    if obj and obj.Parent and obj:FindFirstChild("Handle") then
                        obj.Handle.Transparency = 0
                    end
                end
                X.hiddenOthersAcc = {}
            else
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= player and p.Character then
                        for _, obj in ipairs(p.Character:GetChildren()) do
                            if obj:IsA("Accessory") and obj:FindFirstChild("Handle") then
                                obj.Handle.Transparency = 1
                                table.insert(X.hiddenOthersAcc, obj)
                            end
                        end
                    end
                end
            end
        end,
    })

    task.spawn(function()
        while hubAlive do
            task.wait(0.3)
            local target = getRageTarget()
            if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local hum = target.Character:FindFirstChildOfClass("Humanoid")
                local hrp = target.Character.HumanoidRootPart
                local myPos = myHrp()
                local dist = myPos and math.floor((hrp.Position - myPos.Position).Magnitude) or -1
                pcall(function()
                    X.hudLabel:SetText(string.format("Target: %s | HP: %d | Dist: %d", target.Name, math.floor(hum.Health), dist))
                end)
            else
                pcall(function() X.hudLabel:SetText("Target: none") end)
            end

            local elapsed = tick() - X.candyWindowStart
            if elapsed >= 60 then
                pcall(function() X.candyLabel:SetText("Candy/min: " .. X.candyCollected) end)
                X.candyCollected = 0
                X.candyWindowStart = tick()
            end
        end
    end)

    task.spawn(function()
        while hubAlive do
            task.wait(0.05)
            if X.candyPriorityOn then
                local priorityNames = { "Candy_25", "Candy_10", "Candy_5", "Candy_1" }
                local map = workspace:FindFirstChild("Map")
                if map then
                    for _, name in ipairs(priorityNames) do
                        if not X.candyPriorityOn then break end
                        for _, obj in ipairs(map:GetChildren()) do
                            if obj.Name == name and obj:IsA("BasePart") then
                                local hrp = myHrp()
                                if hrp then
                                    pcall(function() hrp.CFrame = obj.CFrame + Vector3.new(0, 2, 0) end)
                                    task.wait(0.1)
                                    local ok = tryFireCD(hrp, obj)
                                    if ok then X.candyCollected += 1 end
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while hubAlive do
            task.wait()
            if X.orbitOn then
                local hrp = myHrp()
                local target = X.orbitTarget
                if target and isValidTarget(target) then
                    local tHrp = target.Character.HumanoidRootPart
                    X.orbitAngle = (X.orbitAngle + X.orbitSpeed * (1 / 60)) % (2 * math.pi)
                    local offset = Vector3.new(math.cos(X.orbitAngle), 0, math.sin(X.orbitAngle)) * X.orbitDistance
                    if hrp then hrp.CFrame = CFrame.new(tHrp.Position + offset, tHrp.Position) end
                else
                    X.orbitTarget = getRageTarget()
                end
            end
        end
    end)

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            X.killauraOn = false
            X.orbitOn = false
            X.candyPriorityOn = false
            pcall(function() crosshairH:Remove() end)
            pcall(function() crosshairV:Remove() end)
            if X.crosshairOn then UserInputService.MouseIconEnabled = true end
            X.crosshairOn = false
        end)
    end

    hubConnect(RunService.RenderStepped, function()
        if X.crosshairOn then
            UserInputService.MouseIconEnabled = false
            local m = UserInputService:GetMouseLocation()
            local cx, cy = m.X, m.Y
            crosshairH.Visible = true
            crosshairH.From = Vector2.new(cx - 6, cy)
            crosshairH.To = Vector2.new(cx + 6, cy)
            crosshairV.Visible = true
            crosshairV.From = Vector2.new(cx, cy - 6)
            crosshairV.To = Vector2.new(cx, cy + 6)
        end
    end)
end

