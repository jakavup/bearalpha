    local INK = Color3.new(1, 1, 1)
    local MUTED = Color3.fromRGB(140, 140, 140)
    local DARK = Color3.fromRGB(70, 70, 70)
    local BG = Color3.new(0, 0, 0)
    local NOISE = "!@#$%&*/\\|<>?=+~-_01"
    local SPIN = { "|", "/", "-", "\\" }

    local Glyphs = {
        B = { " ____  ", "| __ ) ", "|  _ \\ ", "| |_) |", "|____/ " },
        ["."] = { "   ", "   ", "   ", " _ ", "(_)" },
        A = { "    _    ", "   / \\   ", "  / _ \\  ", " / ___ \\ ", "/_/   \\_\\" },
        [" "] = { "  ", "  ", "  ", "  ", "  " },
        H = { " _   _ ", "| | | |", "| |_| |", "|  _  |", "|_| |_|" },
        U = { " _   _ ", "| | | |", "| | | |", "| |_| |", " \\___/ " },
    }

    local function banner(text)
        local rows = { "", "", "", "", "" }
        for i = 1, #text do
            local g = Glyphs[string.sub(text, i, i)]
            for r = 1, 5 do rows[r] = rows[r] .. g[r] end
        end
        return rows
    end

    local ART = banner("B.A. HUB")
    local Players = game:GetService("Players")
    local Stats = game:GetService("Stats")

    local function fnOk(f) return type(f) == "function" end

    local STEPS = {
        { "executor", function()
            local ok, name, ver = pcall(function() return identifyexecutor() end)
            if ok and name then return string.lower(tostring(name) .. (ver and (" " .. tostring(ver)) or "")) end
            return "unknown"
        end },
        { "place", function()
            return tostring(game.PlaceId)
        end },
        { "player", function()
            local p = Players.LocalPlayer
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local rig = hum and (hum.RigType == Enum.HumanoidRigType.R15 and "r15" or "r6") or "no char"
            return string.lower(p.Name) .. " / " .. rig
        end },
        { "drawing api", function()
            return (type(Drawing) == "table" and fnOk(Drawing.new)) and "ok" or "missing"
        end },
        { "http", function()
            local req = fnOk(request) or fnOk(http_request) or (syn and fnOk(syn.request))
            local get = pcall(function() return game.HttpGet end)
            return (get and "httpget" or "no httpget") .. (req and " + request" or "")
        end },
        { "fs", function()
            return (fnOk(writefile) and fnOk(readfile)) and "ok" or "missing"
        end },
        { "ping", function()
            local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            return ok and string.format("%d ms", math.floor(v + 0.5)) or "n/a"
        end },
        { "fps", function()
            local n, t0 = 0, os.clock()
            while os.clock() - t0 < 0.25 do RunService.RenderStepped:Wait(); n += 1 end
            return string.format("%d", math.floor(n / (os.clock() - t0) + 0.5))
        end },
    }

    local function tween(inst, t, props, style, dir)
        local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
        tw:Play()
        return tw
    end

    local function make(class, props, parent)
        local inst = Instance.new(class)
        for k, v in pairs(props) do inst[k] = v end
        if parent then inst.Parent = parent end
        return inst
    end

    local function noiseChar()
        local i = math.random(1, #NOISE)
        return string.sub(NOISE, i, i)
    end

    local function scramble(final, revealed, band)
        local out = table.create(#final)
        for i = 1, #final do
            local c = string.sub(final, i, i)
            if i <= revealed then
                out[i] = c
            elseif i <= revealed + band and c ~= " " then
                out[i] = noiseChar()
            elseif i <= revealed + band then
                out[i] = math.random() < 0.3 and noiseChar() or " "
            else
                out[i] = " "
            end
        end
        return table.concat(out)
    end

    local function dissolve(final, keep)
        local out = table.create(#final)
        for i = 1, #final do
            local c = string.sub(final, i, i)
            local r = math.random()
            if c == " " then
                out[i] = " "
            elseif r < keep then
                out[i] = c
            elseif r < keep + 0.15 then
                out[i] = noiseChar()
            else
                out[i] = " "
            end
        end
        return table.concat(out)
    end

    local function bar(pct, width)
        local fill = math.floor(pct * width + 0.5)
        return "[" .. string.rep("#", fill) .. string.rep(".", width - fill) .. "]"
    end

    local function dots(label, width)
        return label .. " " .. string.rep(".", math.max(width - #label, 2))
    end

    local parent = CoreGui
    pcall(function() if gethui then parent = gethui() end end)

    local gui = make("ScreenGui", {
        Name = HttpService:GenerateGUID(false), ResetOnSpawn = false,
        IgnoreGuiInset = true, DisplayOrder = 100000,
    })
    local dim = make("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = BG, BackgroundTransparency = 1, BorderSizePixel = 0,
    }, gui)
    local blur
    pcall(function() blur = make("BlurEffect", { Name = HttpService:GenerateGUID(false), Size = 0 }, Lighting) end)

    local scan = make("Frame", {
        Size = UDim2.new(1, 0, 0, 2), Position = UDim2.fromScale(0, -0.02),
        BackgroundColor3 = INK, BackgroundTransparency = 0.85, BorderSizePixel = 0,
    }, gui)

    local holder = make("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(560, 300), BackgroundTransparency = 1,
    }, gui)
    local holderScale = make("UIScale", { Scale = 1 }, holder)

    local LINE_H = 18
    local artLabels = {}
    for r = 1, #ART do
        artLabels[r] = make("TextLabel", {
            Position = UDim2.fromOffset(0, (r - 1) * LINE_H), Size = UDim2.new(1, 0, 0, LINE_H),
            BackgroundTransparency = 1, Text = "", TextColor3 = INK,
            Font = Enum.Font.Code, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center,
        }, holder)
    end
    local artShadow = {}
    for r = 1, #ART do
        artShadow[r] = make("TextLabel", {
            Position = UDim2.fromOffset(2, (r - 1) * LINE_H + 2), Size = UDim2.new(1, 0, 0, LINE_H),
            BackgroundTransparency = 1, Text = "", TextColor3 = DARK, ZIndex = 0,
            Font = Enum.Font.Code, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center,
        }, holder)
    end

    local ruleY = #ART * LINE_H + 10
    local rule = make("TextLabel", {
        Position = UDim2.fromOffset(0, ruleY), Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1,
        Text = "", TextColor3 = MUTED, Font = Enum.Font.Code, TextSize = 14,
    }, holder)

    local LOG_X = 110
    local logLabels = {}
    for i = 1, #STEPS do
        logLabels[i] = make("TextLabel", {
            Position = UDim2.fromOffset(LOG_X, ruleY + 22 + (i - 1) * 16), Size = UDim2.new(1, -LOG_X, 0, 16),
            BackgroundTransparency = 1, Text = "", TextColor3 = MUTED,
            Font = Enum.Font.Code, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left,
        }, holder)
    end

    local progress = make("TextLabel", {
        Position = UDim2.fromOffset(0, ruleY + 22 + #STEPS * 16 + 10), Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1, Text = "", TextColor3 = INK,
        Font = Enum.Font.Code, TextSize = 16,
    }, holder)

    gui.Parent = parent

    local function setArt(r, text)
        artLabels[r].Text = text
        artShadow[r].Text = text
    end

    local function playScan()
        scan.Position = UDim2.fromScale(0, -0.02)
        tween(scan, 1.1, { Position = UDim2.fromScale(0, 1.02) }, Enum.EasingStyle.Linear)
    end

    tween(dim, 0.5, { BackgroundTransparency = 0.25 })
    if blur then tween(blur, 0.5, { Size = 18 }) end
    playScan()
    task.wait(0.35)

    local width = #ART[1]
    local band = 8
    local revealTime = 1.3
    local t0 = os.clock()
    while true do
        local t = os.clock() - t0
        local done = true
        for r = 1, #ART do
            local lag = (r - 1) * 0.08
            local f = math.clamp((t - lag) / revealTime, 0, 1)
            local revealed = math.floor(f * (width + band))
            setArt(r, scramble(ART[r], revealed, band))
            if f < 1 then done = false end
        end
        if done then break end
        RunService.RenderStepped:Wait()
    end
    for r = 1, #ART do setArt(r, ART[r]) end

    for i = 1, 3 do
        for r = 1, #ART do artLabels[r].TextColor3 = i % 2 == 1 and MUTED or INK end
        task.wait(0.05)
    end
    for r = 1, #ART do artLabels[r].TextColor3 = INK end

    local ruleFull = "+" .. string.rep("-", width - 2) .. "+"
    for i = 1, #ruleFull, 3 do
        rule.Text = string.sub(ruleFull, 1, i)
        task.wait(0.01)
    end
    rule.Text = ruleFull

    local total = #STEPS
    for i, entry in ipairs(STEPS) do
        local step, probe = entry[1], entry[2]
        local label = "> " .. dots(step, 14)
        for c = 1, #label do
            logLabels[i].Text = string.sub(label, 1, c)
            if c % 2 == 0 then task.wait(0.008) end
        end
        local result
        task.spawn(function()
            local ok, v = pcall(probe)
            result = ok and tostring(v) or "error"
        end)
        local spinFor = 0.18
        local s0 = os.clock()
        local k = 0
        while result == nil or os.clock() - s0 < spinFor do
            k += 1
            logLabels[i].Text = label .. " " .. SPIN[(k % #SPIN) + 1]
            local pct = ((i - 1) + math.min((os.clock() - s0) / spinFor, 0.9)) / total
            progress.Text = string.format("%s %3d%%", bar(pct, 28), math.floor(pct * 100))
            task.wait(0.05)
        end
        logLabels[i].Text = label .. " " .. result
        logLabels[i].TextColor3 = INK
        tween(logLabels[i], 0.4, { TextColor3 = MUTED })
    end
    progress.Text = string.format("%s %3d%%", bar(1, 28), 100)

    task.wait(0.15)
    for i = 1, 4 do
        progress.Text = i % 2 == 1 and "[ ready ]" or ""
        task.wait(0.09)
    end
    progress.Text = "[ ready ]"
    task.wait(0.35)

    playScan()
    tween(holderScale, 0.12, { Scale = 1.04 }, Enum.EasingStyle.Quad)
    local d0 = os.clock()
    local outTime = 0.55
    while os.clock() - d0 < outTime do
        local keep = 1 - (os.clock() - d0) / outTime
        for r = 1, #ART do setArt(r, dissolve(ART[r], keep)) end
        rule.Text = dissolve(ruleFull, keep)
        for _, l in ipairs(logLabels) do l.TextTransparency = 1 - keep end
        progress.TextTransparency = 1 - keep
        RunService.RenderStepped:Wait()
    end
    for r = 1, #ART do setArt(r, "") end
    rule.Text = ""

    tween(holderScale, 0.3, { Scale = 0.9 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tween(dim, 0.4, { BackgroundTransparency = 1 })
    tween(scan, 0.3, { BackgroundTransparency = 1 })
    if blur then tween(blur, 0.4, { Size = 0 }) end
    task.wait(0.45)

    gui:Destroy()
    if blur then blur:Destroy() end
end

