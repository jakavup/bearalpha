local SCALE_VALUES = { "BodyDepthScale", "BodyHeightScale", "BodyWidthScale", "HeadScale" }

function LV.isTracked(d)
    return d:IsA("BasePart") and not d:FindFirstAncestorOfClass("Tool")
end

function LV.isClothing(o)
    return o:IsA("Shirt") or o:IsA("Pants") or o:IsA("ShirtGraphic")
end

function LV.rebuildParts()
    local list = {}
    if LV.char then
        for _, d in ipairs(LV.char:GetDescendants()) do
            if LV.isTracked(d) then list[#list + 1] = d end
        end
    end
    LV.parts = list
end

function LV.currentColor(dt)
    local now = os.clock()
    if LV.strobe then
        local h
        if LV.strobeCustom then
            h = (LV.strobeBase + math.sin(now * LV.strobeSpeed * 0.3) * LV.strobeRange) % 1
        else
            LV.strobeHue = (LV.strobeHue + dt * LV.strobeSpeed) % 1
            h = LV.strobeHue
        end
        return Color3.fromHSV(h, 1, 1)
    end
    if LV.rainbow then
        local h
        if LV.rainbowCustom then
            h = (LV.rainbowBase + math.sin(now * LV.rainbowSpeed * 3) * LV.rainbowRange) % 1
        else
            LV.rainbowHue = (LV.rainbowHue + dt * LV.rainbowSpeed) % 1
            h = LV.rainbowHue
        end
        return Color3.fromHSV(h, 1, 1)
    end
    return nil
end

function LV.stashClothes()
    if not LV.char then return end
    for _, o in ipairs(LV.char:GetChildren()) do
        if LV.isClothing(o) then
            LV.clothes[#LV.clothes + 1] = o
            pcall(function() o.Parent = nil end)
        end
    end
end

function LV.restoreClothes()
    local char = LV.char
    for _, o in ipairs(LV.clothes) do
        if char and char.Parent then
            pcall(function() o.Parent = char end)
        else
            pcall(function() o:Destroy() end)
        end
    end
    LV.clothes = {}
end

function LV.restoreColors()
    for part, c in pairs(LV.savedColor) do
        if part.Parent then pcall(function() part.Color = c end) end
    end
    LV.savedColor = {}
end

function LV.hideAccessory(acc)
    local h = acc:FindFirstChild("Handle")
    if h and h:IsA("BasePart") and LV.accSaved[h] == nil then
        LV.accSaved[h] = h.Transparency
        h.Transparency = 1
    end
end

function LV.applyAccessories()
    if LV.hideAcc and LV.char then
        for _, o in ipairs(LV.char:GetChildren()) do
            if o:IsA("Accessory") then LV.hideAccessory(o) end
        end
    else
        for h, t in pairs(LV.accSaved) do
            if h.Parent then pcall(function() h.Transparency = t end) end
        end
        LV.accSaved = {}
    end
end

function LV.applyForceField()
    if LV.forcefield and LV.char then
        if not (LV.ff and LV.ff.Parent == LV.char) then
            if LV.ff then pcall(function() LV.ff:Destroy() end) end
            local ff = Instance.new("ForceField")
            ff.Visible = true
            ff.Parent  = LV.char
            LV.ff = ff
        end
    elseif LV.ff then
        pcall(function() LV.ff:Destroy() end)
        LV.ff = nil
    end
end

LV.particleMakers = {
    Sparkles = function(c)
        local o = Instance.new("Sparkles")
        o.SparkleColor = c
        return o
    end,
    Fire = function(c)
        local o = Instance.new("Fire")
        local h, s, v = c:ToHSV()
        o.Color          = c
        o.SecondaryColor = Color3.fromHSV(h, s * 0.6, math.min(v + 0.2, 1))
        o.Size           = 4
        o.Heat           = 6
        return o
    end,
    Smoke = function(c)
        local o = Instance.new("Smoke")
        o.Color        = c
        o.Opacity      = 0.25
        o.RiseVelocity = 3
        o.Size         = 1.5
        return o
    end,
}

function LV.applyParticle()
    if LV.particleObj then
        pcall(function() LV.particleObj:Destroy() end)
        LV.particleObj = nil
    end
    if not LV.particle then return end
    local hrp = LV.char and LV.char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local maker = LV.particleMakers[LV.particleType] or LV.particleMakers.Sparkles
    local obj = maker(LV.particleColor)
    obj.Parent = hrp
    LV.particleObj = obj
end

function LV.trailColors()
    if LV.trailRGB then
        return Color3.fromHSV(LV.trailRGBHue, 1, 1), Color3.fromHSV((LV.trailRGBHue + 0.5) % 1, 1, 1)
    end
    return Color3.fromHSV(LV.trailHue0, 1, 1), Color3.fromHSV(LV.trailHue1, 1, 1)
end

function LV.styleTrail()
    local t = LV.trailInst
    if not t then return end
    local c0, c1 = LV.trailColors()
    t.Color         = ColorSequence.new(c0, c1)
    t.Lifetime      = LV.trailLife
    t.LightEmission = LV.trailGlow
    t.Transparency  = LV.trailFade and NumberSequence.new(0, 1) or NumberSequence.new(0)
    local half = LV.trailWidth / 2
    if LV.trailAtts[1] then LV.trailAtts[1].Position = Vector3.new(0,  half, 0) end
    if LV.trailAtts[2] then LV.trailAtts[2].Position = Vector3.new(0, -half, 0) end
end

function LV.destroyTrail()
    if LV.trailInst then pcall(function() LV.trailInst:Destroy() end) end
    for _, a in ipairs(LV.trailAtts) do pcall(function() a:Destroy() end) end
    LV.trailInst, LV.trailAtts = nil, {}
end

function LV.applyTrail()
    LV.destroyTrail()
    if not LV.trail then return end
    local hrp = LV.char and LV.char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local a0 = Instance.new("Attachment")
    a0.Name   = "LVTrail0"
    a0.Parent = hrp
    local a1 = Instance.new("Attachment")
    a1.Name   = "LVTrail1"
    a1.Parent = hrp
    local t = Instance.new("Trail")
    t.Attachment0 = a0
    t.Attachment1 = a1
    t.MinLength   = 0
    t.FaceCamera  = true
    t.WidthScale  = NumberSequence.new(1, 0)
    t.Parent      = hrp
    LV.trailInst, LV.trailAtts = t, { a0, a1 }
    LV.styleTrail()
end

function LV.applyScale()
    local hum = LV.char and LV.char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local any = false
    for _, n in ipairs(SCALE_VALUES) do
        local v = hum:FindFirstChild(n)
        if v and v:IsA("NumberValue") then
            v.Value = LV.scale
            any = true
        end
    end
    if not any and LV.scale ~= 1 and not LV.warnedScale then
        LV.warnedScale = true
        Library:Notify("Character Scale needs an R15 rig.", 3)
    end
end

function LV.onRender(dt)
    if LV.dead or not LV.char then return end
    if LV.dirty then
        LV.dirty = false
        LV.rebuildParts()
    end

    local color = LV.currentColor(dt)
    if color then
        if not LV.colorActive then
            LV.colorActive = true
            LV.stashClothes()
        end
        for _, p in ipairs(LV.parts) do
            if LV.savedColor[p] == nil then LV.savedColor[p] = p.Color end
            p.Color = color
        end
    elseif LV.colorActive then
        LV.colorActive = false
        LV.restoreColors()
        LV.restoreClothes()
    end

    if LV.ghost or LV.ghostCur > 0 then
        local target = LV.ghost and LV.ghostAlpha or 0
        LV.ghostCur = LV.ghostCur + (target - LV.ghostCur) * math.min(dt * 10, 1)
        if math.abs(LV.ghostCur - target) < 0.005 then LV.ghostCur = target end
        for _, p in ipairs(LV.parts) do p.LocalTransparencyModifier = LV.ghostCur end
    end

    if LV.trailRGB and LV.trailInst then
        LV.trailRGBHue = (LV.trailRGBHue + dt * LV.trailRGBSpeed) % 1
        local c0, c1 = LV.trailColors()
        LV.trailInst.Color = ColorSequence.new(c0, c1)
    end
end

function LV.bind(char)
    for _, c in ipairs(LV.charConns) do c:Disconnect() end
    LV.charConns  = {}
    LV.char       = char
    LV.parts      = {}
    LV.savedColor = {}
    LV.accSaved   = {}
    LV.clothes    = {}
    LV.colorActive = false
    LV.ghostCur   = 0
    LV.ff, LV.particleObj, LV.trailInst, LV.trailAtts = nil, nil, nil, {}
    LV.dirty      = true
    if not char then return end

    local function markDirty(d)
        if LV.isTracked(d) then LV.dirty = true end
    end
    table.insert(LV.charConns, char.DescendantAdded:Connect(markDirty))
    table.insert(LV.charConns, char.DescendantRemoving:Connect(markDirty))
    table.insert(LV.charConns, char.ChildAdded:Connect(function(o)
        task.defer(function()
            if LV.dead or LV.char ~= char or o.Parent ~= char then return end
            if LV.colorActive and LV.isClothing(o) then
                LV.clothes[#LV.clothes + 1] = o
                pcall(function() o.Parent = nil end)
            elseif LV.hideAcc and o:IsA("Accessory") then
                o:WaitForChild("Handle", 3)
                if LV.hideAcc and LV.char == char then LV.hideAccessory(o) end
            end
        end)
    end))

    task.spawn(function()
        local hrp = char:WaitForChild("HumanoidRootPart", 5)
        if not hrp or LV.dead or LV.char ~= char then return end
        LV.applyForceField()
        LV.applyAccessories()
        LV.applyParticle()
        LV.applyTrail()
        if LV.scale ~= 1 then LV.applyScale() end
    end)
end

function LV.cleanup()
    if LV.dead then return end
    LV.rainbow, LV.strobe, LV.ghost = false, false, false
    LV.restoreColors()
    LV.restoreClothes()
    for _, p in ipairs(LV.parts) do pcall(function() p.LocalTransparencyModifier = 0 end) end
    LV.hideAcc = false
    LV.applyAccessories()
    LV.forcefield = false
    LV.applyForceField()
    LV.particle = false
    LV.applyParticle()
    LV.destroyTrail()
    LV.dead = true
    for _, c in ipairs(LV.charConns) do c:Disconnect() end
    for _, c in ipairs(LV.conns) do c:Disconnect() end
    LV.charConns, LV.conns = {}, {}
end

