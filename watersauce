do
    local I = {
        enabled = false,
        key = Enum.KeyCode.F,
        offset = Vector3.new(0.4, -0.4, -1.5),
        bind = "BAInspectStep",
        active = nil,
        conns = {},
    }
    local R = math.rad
    local REST_ROT = CFrame.Angles(R(90), 0, 0)
    local keys = {
        { t = 0.00, pos = Vector3.new(1.00, -1.20, -1.50), rot = CFrame.Angles(0, 0, 0) },
        { t = 0.35, pos = Vector3.new(0.55, -0.75, -1.40), rot = CFrame.Angles(R(8), R(-25), R(10)) },
        { t = 0.95, pos = Vector3.new(0.40, -0.60, -1.30), rot = CFrame.Angles(R(12), R(-70), R(-15)) },
        { t = 1.45, pos = Vector3.new(0.42, -0.58, -1.30), rot = CFrame.Angles(R(10), R(-66), R(-12)) },
        { t = 1.75, pos = Vector3.new(0.35, -0.55, -1.25), rot = CFrame.Angles(R(0), R(-10), R(95)) },
        { t = 2.10, pos = Vector3.new(0.35, -0.60, -1.30), rot = CFrame.Angles(R(-10), R(60), R(175)) },
        { t = 2.60, pos = Vector3.new(0.38, -0.62, -1.30), rot = CFrame.Angles(R(-8), R(56), R(172)) },
        { t = 3.00, pos = Vector3.new(0.70, -0.95, -1.45), rot = CFrame.Angles(R(0), R(10), R(30)) },
        { t = 3.30, pos = Vector3.new(1.00, -1.20, -1.50), rot = CFrame.Angles(0, 0, 0) },
    }
    local duration = keys[#keys].t
    local keepClasses = {
        SpecialMesh = true, BlockMesh = true, CylinderMesh = true, FileMesh = true,
        Decal = true, Texture = true, SurfaceAppearance = true,
    }

    local function ease(a)
        return a < 0.5 and 4 * a * a * a or 1 - (-2 * a + 2) ^ 3 / 2
    end

    local function sample(t)
        if t <= 0 then return keys[1] end
        for i = 2, #keys do
            local b = keys[i]
            if t <= b.t then
                local a = keys[i - 1]
                local f = ease((t - a.t) / (b.t - a.t))
                return { pos = a.pos:Lerp(b.pos, f), rot = a.rot:Lerp(b.rot, f) }
            end
        end
        return keys[#keys]
    end

    local function firstPerson(char)
        local cam = workspace.CurrentCamera
        local head = char and char:FindFirstChild("Head")
        return cam and head and (cam.CFrame.Position - head.Position).Magnitude < 1
    end

    local function heldTool(char)
        return char and char:FindFirstChildOfClass("Tool")
    end

    local function findGrip(char)
        for _, name in ipairs({ "RightHand", "Right Arm" }) do
            local hand = char:FindFirstChild(name)
            local grip = hand and hand:FindFirstChild("RightGrip")
            if grip and grip:IsA("JointInstance") and grip.Part0 and grip.Part1 then
                return hand, grip
            end
        end
        return nil
    end

    local function cloneOf(inst)
        local old = inst.Archivable
        inst.Archivable = true
        local ok, c = pcall(function() return inst:Clone() end)
        inst.Archivable = old
        return ok and c or nil
    end

    local function visualClone(part)
        local c = cloneOf(part)
        if not c then return nil end
        for _, d in ipairs(c:GetChildren()) do
            if not keepClasses[d.ClassName] then d:Destroy() end
        end
        c.Anchored = true
        c.CanCollide = false
        c.CanQuery = false
        c.CanTouch = false
        c.CastShadow = false
        c.Massless = true
        c.LocalTransparencyModifier = 0
        return c
    end

    local function stop()
        local a = I.active
        if not a then return end
        I.active = nil
        pcall(RunService.UnbindFromRenderStep, RunService, I.bind)
        for _, h in ipairs(a.hidden) do
            if h[1].Parent then h[1].LocalTransparencyModifier = h[2] end
        end
        pcall(function() a.model:Destroy() end)
    end

    local function step()
        local a = I.active
        if not a then return end
        local char = player.Character
        if not I.enabled or not char or heldTool(char) ~= a.tool or not firstPerson(char) then return stop() end
        local t = os.clock() - a.start
        if t >= duration then return stop() end
        local k = sample(t)
        local root = workspace.CurrentCamera.CFrame * CFrame.new(k.pos + I.offset) * k.rot * REST_ROT
        for _, h in ipairs(a.hidden) do h[1].LocalTransparencyModifier = 1 end
        local parts, cfs = table.create(#a.parts), table.create(#a.parts)
        for i, p in ipairs(a.parts) do
            parts[i], cfs[i] = p[1], root * p[2]
        end
        workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
    end

    local function start()
        local char = player.Character
        local tool = heldTool(char)
        if not tool or not firstPerson(char) then return end
        local hand, grip = findGrip(char)
        if not hand then return end
        stop()
        local model = Instance.new("Model")
        model.Name = "InspectViewmodel"
        local entry = { model = model, parts = {}, hidden = {}, tool = tool, start = os.clock() }
        local handCF = hand.CFrame

        local hum = Instance.new("Humanoid")
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
        hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
        hum.RequiresNeck = false
        local realHum = char:FindFirstChildOfClass("Humanoid")
        local isR15 = realHum and realHum.RigType == Enum.HumanoidRigType.R15
        if isR15 then hum.RigType = Enum.HumanoidRigType.R15 end
        hum.Parent = model
        for _, src in ipairs(char:GetChildren()) do
            if src:IsA("Shirt") or (not isR15 and src:IsA("CharacterMesh")) then
                local c = cloneOf(src)
                if c then c.Parent = model end
            end
        end
        local armNames = isR15 and { "RightHand", "RightLowerArm", "RightUpperArm" } or { "Right Arm" }
        for _, name in ipairs(armNames) do
            local p = char:FindFirstChild(name)
            if p and p:IsA("BasePart") then
                local c = visualClone(p)
                if c then
                    entry.parts[#entry.parts + 1] = { c, handCF:ToObjectSpace(p.CFrame) }
                    entry.hidden[#entry.hidden + 1] = { p, p.LocalTransparencyModifier }
                    c.Parent = model
                end
            end
        end

        local handleCF = handCF * grip.C0 * grip.C1:Inverse()
        local handle = grip.Part1
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("BasePart") then
                local c = visualClone(d)
                if c then
                    local rel = handle.CFrame:ToObjectSpace(d.CFrame)
                    entry.parts[#entry.parts + 1] = { c, handCF:ToObjectSpace(handleCF * rel) }
                    entry.hidden[#entry.hidden + 1] = { d, d.LocalTransparencyModifier }
                    c.Parent = model
                end
            end
        end

        if #entry.parts == 0 then model:Destroy() return end
        model.Parent = workspace.CurrentCamera
        I.active = entry
        RunService:BindToRenderStep(I.bind, Enum.RenderPriority.Camera.Value + 3, step)
        step()
    end

    grpFun:AddToggle("InspectTool", {
        Text = "Inspect Tool", Default = false,
        Callback = function(v)
            I.enabled = v
            if not v then stop() end
        end,
    }):AddKeyPicker("InspectToolKey", {
        Default = "F", Mode = "Hold", Text = "Inspect Key", NoUI = false,
        ChangedCallback = function(k)
            if typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then I.key = k end
        end,
    })

    table.insert(I.conns, UserInputService.InputBegan:Connect(function(input, gp)
        if gp or not I.enabled or UserInputService:GetFocusedTextBox() then return end
        if input.KeyCode == I.key then
            start()
        elseif input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2 then
            stop()
        end
    end))

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            I.enabled = false
            stop()
            for _, c in ipairs(I.conns) do c:Disconnect() end
            I.conns = {}
        end)
    end
end

