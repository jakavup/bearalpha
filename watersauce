            end
        end,
    })
    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            for _, c in pairs(menuGuis) do c:Disconnect() end
            for o, sz in pairs(baseSize) do pcall(function() o.TextSize = sz end) end
        end)
    end
end

