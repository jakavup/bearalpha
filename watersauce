                    end
                    task.wait(0.3)
                end
            end
            smokingThings = false
            Library:Notify("Smoke done.", 3)
        end
    end
end)

task.spawn(function()
    local masteryOwnsDance = false
    local quidzOwned = false

    local function releaseQuidz()
        if quidzOwned then
            farmingQuidz = false
            quidzOwned = false
        end
    end

    local function masteryDance()
        if currentDanceTrack then return end
        if playDance() then masteryOwnsDance = true end
    end

    local function puzzleActive(name)
        local map = workspace:FindFirstChild("Map")
        return map and map:FindFirstChild(name) ~= nil and not masteryFarmed[name]
    end

    local function waitForResult(flag, limit)
        local t = tick()
        while flag() and tick() - t < (limit or 30) do task.wait(0.2) end
    end

    while hubAlive do
        task.wait(0.1)
        if not masteryFarming then
            if masteryOwnsDance and currentDanceTrack then stopDance() end
            masteryOwnsDance = false
            releaseQuidz()
            continue
        end

        local team = player.Team
        if masteryQuidzWhenDead and team and team.Name == "Waiting" then
            if not farmingQuidz then
                farmingQuidz = true
                quidzOwned = true
            end
            task.wait(1)
            continue
        end
        releaseQuidz()

        if not team or team.Name ~= "Survivors" then
            task.wait(3)
            continue
        end

        local hasCC    = puzzleActive("ColorCode")
        local hasWire  = puzzleActive("Wire")
        local hasAltar = puzzleActive("CheeseAltar")
        local hasMem    = puzzleActive("Memory")
        local hasSquash = puzzleActive("PinkSquash")
        local hasSmoke  = puzzleActive("Smoke")
        local hasPainting = puzzleActive("Painting")

        if not hasCC and not hasWire and not hasAltar and not hasMem
            and not hasSquash and not hasSmoke and not hasPainting then
            masteryDance()
            task.wait(3)
            continue
        end

        stopDance()

        if hasCC then
            solvingCC = true
            waitForResult(function() return solvingCC end)
            masteryFarmed["ColorCode"] = true
            task.wait(1)
            if not masteryFarming then continue end
        end

        if hasWire then
            solvingWire = true
            waitForResult(function() return solvingWire end)
            masteryFarmed["Wire"] = true
            task.wait(1)
            if not masteryFarming then continue end
        end
        if hasSquash then
            local before = squashPasses
            squashingThings = true
            local t = tick()
            while masteryFarming and squashPasses == before and tick() - t < 60 do task.wait(0.2) end
            squashingThings = false
            masteryFarmed["PinkSquash"] = true
            task.wait(1)
            if not masteryFarming then continue end
        end

        if hasSmoke then
            smokingThings = true
            waitForResult(function() return smokingThings end, 60)
            smokingThings = false
            masteryFarmed["Smoke"] = true
            task.wait(1)
            if not masteryFarming then continue end
        end

        if hasPainting then
            solvingPaintings = true
            waitForResult(function() return solvingPaintings end, 150)
            solvingPaintings = false
            masteryFarmed["Painting"] = true
            task.wait(1)
            if not masteryFarming then continue end
        end
        if hasAltar then
            local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    local altar   = workspace:WaitForChild("Map",10):WaitForChild("CheeseAltar",10)
                    local d1      = altar:WaitForChild("Items",10):WaitForChild("Item",10):WaitForChild("Detect",10)
                    if (hrp.Position - d1.Position).Magnitude > 10 then
                        teleportTo(d1)
                        task.wait(0.3)
                    end
                    hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    local baseDet = altar:WaitForChild("Base",10):WaitForChild("Detect",10)
                    hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    hrp.CFrame = CFrame.new(baseDet.Position + Vector3.new(0, 10, 0)) * hrp.CFrame.Rotation
                    task.wait(0.1)
                    firetouchinterest(hrp, baseDet, 0)
                    task.wait(0.1)
                    firetouchinterest(hrp, baseDet, 1)
                end)
            end
            masteryFarmed["CheeseAltar"] = true
            task.wait(1.5)
            if not masteryFarming then continue end
        end

        if hasMem then
            solveMemoryGame()
            masteryFarmed["Memory"] = true
            task.wait(1)
        end
    end
end)

