do
    local lg = { on = false, saved = nil }
    local function captureGfx()
        local l = lighting
        return {
            GlobalShadows = l.GlobalShadows,
            FogEnd = l.FogEnd,
            EnvironmentDiffuseScale = l.EnvironmentDiffuseScale,
            EnvironmentSpecularScale = l.EnvironmentSpecularScale,
            Brightness = l.Brightness,
            quality = (settings and pcall(function() return settings().Rendering.QualityLevel end)) and settings().Rendering.QualityLevel or nil,
        }
    end
    local function postEffects(disable)
        for _, d in ipairs(lighting:GetDescendants()) do
            if d:IsA("PostEffect") or d:IsA("BlurEffect") or d:IsA("SunRaysEffect")
                or d:IsA("BloomEffect") or d:IsA("DepthOfFieldEffect") then
                pcall(function()
                    if disable then
                        if lg.saved and lg.saved.fx and lg.saved.fx[d] == nil then lg.saved.fx[d] = d.Enabled end
                        d.Enabled = false
                    elseif lg.saved and lg.saved.fx and lg.saved.fx[d] ~= nil then
                        d.Enabled = lg.saved.fx[d]
                    end
                end)
            end
        end
    end
    T.grpMisc:AddToggle("LowGfx", {
        Text = "Low Graphics", Default = false,
        Callback = function(v)
            lg.on = v
            if v then
                lg.saved = captureGfx()
                lg.saved.fx = {}
                pcall(function() lighting.GlobalShadows = false end)
                pcall(function() lighting.EnvironmentDiffuseScale = 0 end)
                pcall(function() lighting.EnvironmentSpecularScale = 0 end)
                pcall(function() lighting.FogEnd = 9e9 end)
                pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)
                pcall(function()
                    for _, d in ipairs(workspace:GetDescendants()) do
                        if d:IsA("Decal") or d:IsA("Texture") then d.Transparency = 1 end
                    end
                end)
                postEffects(true)
                pcall(function() sethiddenproperty(player, "SimulationRadius", math.huge) end)
            elseif lg.saved then
                pcall(function() lighting.GlobalShadows = lg.saved.GlobalShadows end)
                pcall(function() lighting.EnvironmentDiffuseScale = lg.saved.EnvironmentDiffuseScale end)
                pcall(function() lighting.EnvironmentSpecularScale = lg.saved.EnvironmentSpecularScale end)
                pcall(function() lighting.FogEnd = lg.saved.FogEnd end)
                if lg.saved.quality then pcall(function() settings().Rendering.QualityLevel = lg.saved.quality end) end
                postEffects(false)
                lg.saved = nil
            end
        end,
    })
    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            if lg.on then
                pcall(function() lighting.GlobalShadows = lg.saved and lg.saved.GlobalShadows end)
                if lg.saved and lg.saved.quality then pcall(function() settings().Rendering.QualityLevel = lg.saved.quality end) end
            end
        end)
    end
end
