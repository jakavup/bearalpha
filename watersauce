        images = setmetatable({}, { __mode = "k" }),
        watched = setmetatable({}, { __mode = "k" }),
        humNames = setmetatable({}, { __mode = "k" }),
        rootConns = {},
        running = false,
    }

    local function escPat(x) return (string.gsub(x, "%p", "%%%0")) end
    local function escRep(x) return (string.gsub(x, "%%", "%%%%")) end

    local function rebuildList()
        local list = {}
        if NM.hideOn then
            list[#list + 1] = {
                name = player.Name, display = player.DisplayName, uid = tostring(player.UserId),
                user = NM.alias, disp = NM.aliasDisplay, aliasId = NM.aliasId,
            }
        end
        for _, p in ipairs(Players:GetPlayers()) do
            local cfg = p ~= player and NM.others[p.UserId]
            if cfg then
                list[#list + 1] = {
                    name = p.Name, display = p.DisplayName, uid = tostring(p.UserId),
                    user = cfg.user ~= "" and cfg.user or p.Name,
                    disp = cfg.display ~= "" and cfg.display or p.DisplayName,
                    aliasId = cfg.aliasId,
                }
            end
        end
        table.sort(list, function(x, y) return #x.name > #y.name end)
        NM.list = list
    end

    local function swapText(t)
        local out = t
        for i, e in ipairs(NM.list) do
            local U, D = "\1U" .. i .. "\1", "\1D" .. i .. "\1"
            out = string.gsub(out, "@" .. escPat(e.name), "@" .. U)
            if e.display ~= "" and e.display ~= e.name then
                out = string.gsub(out, escPat(e.display), D)
                out = string.gsub(out, escPat(e.name), U)
            else
                out = string.gsub(out, escPat(e.name), D)
            end
        end
        for i, e in ipairs(NM.list) do
            out = string.gsub(out, "\1U" .. i .. "\1", escRep(e.user))
            out = string.gsub(out, "\1D" .. i .. "\1", escRep(e.disp))
        end
        return out
    end

    local function swapImage(img)
        if type(img) ~= "string" then return img end
        local out = img
        for _, e in ipairs(NM.list) do
            if e.aliasId then
                out = string.gsub(out, "([%?&]id=)" .. e.uid .. "(%f[%D])", "%1" .. e.aliasId .. "%2")
                out = string.gsub(out, "([%?&][uU]ser[iI]d=)" .. e.uid .. "(%f[%D])", "%1" .. e.aliasId .. "%2")
            end
        end
        return out
    end

    local function isText(o)
        return o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")
    end

    local function fix(o)
        if not NM.running then return end
        local t = o.Text
        if type(t) ~= "string" or t == "" then return end
        local new = swapText(t)
        if new ~= t then
            if NM.texts[o] == nil then NM.texts[o] = t end
            o.Text = new
        end
    end

    local function fixImage(o)
        if not NM.running then return end
        local img = o.Image
        local new = swapImage(img)
        if new ~= img then
            if NM.images[o] == nil then NM.images[o] = img end
            o.Image = new
        end
    end

    local function watch(o)
        if NM.watched[o] then return end
        if isText(o) then
            NM.watched[o] = o:GetPropertyChangedSignal("Text"):Connect(function() fix(o) end)
            fix(o)
        elseif o:IsA("ImageLabel") or o:IsA("ImageButton") then
            NM.watched[o] = o:GetPropertyChangedSignal("Image"):Connect(function() fixImage(o) end)
            fixImage(o)
        end
    end

    local function watchRoot(root)
        if not root then return end
        pcall(function()
            for _, d in ipairs(root:GetDescendants()) do watch(d) end
            NM.rootConns[#NM.rootConns + 1] = root.DescendantAdded:Connect(watch)
        end)
    end

    local function applyHumanoidNames()
        for _, p in ipairs(Players:GetPlayers()) do
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                if p == player then
                    pcall(function()
                        hum.DisplayDistanceType = NM.hideOn and Enum.HumanoidDisplayDistanceType.None or Enum.HumanoidDisplayDistanceType.Viewer
                    end)
                else
                    local cfg = NM.others[p.UserId]
                    if cfg and cfg.display ~= "" then
                        if NM.humNames[hum] == nil then NM.humNames[hum] = hum.DisplayName end
                        if hum.DisplayName ~= cfg.display then pcall(function() hum.DisplayName = cfg.display end) end
                    elseif NM.humNames[hum] ~= nil then
                        pcall(function() hum.DisplayName = NM.humNames[hum] end)
                        NM.humNames[hum] = nil
                    end
                end
            end
        end
    end

    local function stopNames()
        NM.running = false
        for _, c in ipairs(NM.rootConns) do pcall(function() c:Disconnect() end) end
        NM.rootConns = {}
        for _, c in pairs(NM.watched) do pcall(function() c:Disconnect() end) end
        table.clear(NM.watched)
        for o, t in pairs(NM.texts) do
            if o.Parent then pcall(function() o.Text = t end) end
        end
        table.clear(NM.texts)
        for o, img in pairs(NM.images) do
            if o.Parent then pcall(function() o.Image = img end) end
        end
        table.clear(NM.images)
    end

    local function refreshNames()
        stopNames()
