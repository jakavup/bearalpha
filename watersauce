    hubConnect(p.CharacterAdded, function()
        removeESPPlayer(p)
        espObjects[p] = createESPObjects()
    end)
    hubConnect(p.CharacterRemoving, function()
        if espObjects[p] then hideESPObjects(espObjects[p]) end
    end)
end

