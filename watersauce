        if not hubAlive then return end
        hubAlive = false

        espEnabled, itemEspEnabled, playerSpeedLabels = false, false, false
        flyEnabled, noclipEnabled, infiniteJump, infiniteStamina, antiAfk = false, false, false, false, false
        spinEnabled, seizureMode = false, false
        rageEnabled, rageKillAura = false, false
        solvingCC, solvingWire, solvingPaintings = false, false, false
        squashingThings, smokingThings = false, false
        farmingCandy, farmingCandyPull, farmingGhosts = false, false, false
        farmingQuidz, farmingHiddenQuidz, masteryFarming = false, false, false

        for _, c in ipairs(hubConns) do pcall(function() c:Disconnect() end) end
        hubConns = {}

        for _, name in ipairs({ "FOVOverride", "FullbrightLoop", "Freecam" }) do
            pcall(function() RunService:UnbindFromRenderStep(name) end)
        end

        if freecamEnabled then
            freecamEnabled = false
            pcall(function()
                camera.CameraType = Enum.CameraType.Custom
                UserInputService.MouseBehavior = Enum.MouseBehavior.Default
