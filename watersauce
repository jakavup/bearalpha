task.spawn(function()
    local masteryOwnsDance = false
    local quidzOwned = false

    local function releaseQuidz()
        if quidzOwned then
            farmingQuidz = false
            quidzOwned = false
        end
    end

    local function masteryDance()
        if currentDanceTrack then return end
        if playDance() then masteryOwnsDance = true end
    end

    local function puzzleActive(name)
        local map = workspace:FindFirstChild("Map")
        return map and map:FindFirstChild(name) ~= nil and not masteryFarmed[name]
    end

    local BEAR_RADIUS = 25
    local deferred = {}

    local function myRoot()
        local char = player.Character
        return char and char:FindFirstChild("HumanoidRootPart")
    end

    local function bearNear(pos, radius)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Team and p.Team.Name == "Bear" then
                local char = p.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 and (hrp.Position - pos).Magnitude <= radius then
                    return hrp
                end
            end
        end
        return nil
    end

    local function bearThreat()
        if not masteryAvoidBear then return false end
        local hrp = myRoot()
        return hrp ~= nil and bearNear(hrp.Position, BEAR_RADIUS) ~= nil
    end

    local function groundAt(pos)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { player.Character }
        local hit = workspace:Raycast(pos + Vector3.new(0, 20, 0), Vector3.new(0, -60, 0), params)
        return hit and (hit.Position + Vector3.new(0, 3, 0)) or pos
    end

    local function dodgeBear()
        local hrp = myRoot()
        if not hrp then return false end
        local spot = hrp.CFrame
        local bear = bearNear(spot.Position, BEAR_RADIUS)
        if not bear then return true end
        local away = spot.Position - bear.Position
        away = Vector3.new(away.X, 0, away.Z)
        if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
        local dest = groundAt(spot.Position + away.Unit * BEAR_RADIUS)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(dest) * spot.Rotation
        task.wait(1.5)
        if not masteryFarming then return false end
        if bearNear(spot.Position, BEAR_RADIUS) then return false end
        hrp = myRoot()
        if not hrp then return false end
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.CFrame = spot
        task.wait(0.2)
        return true
    end

    local function runFlagged(setFlag, isDone, limit)
        setFlag(true)
        local t = tick()
        while masteryFarming and tick() - t < limit do
            if isDone() then return true end
            if bearThreat() then
                setFlag(false)
                if not dodgeBear() then return false end
                task.wait(0.3)
                setFlag(true)
            end
            task.wait(0.1)
        end
        setFlag(false)
        return masteryFarming
    end

    local runners = {
        ColorCode = function()
            return runFlagged(function(v) solvingCC = v end, function() return not solvingCC end, 30)
        end,
        Wire = function()
            return runFlagged(function(v) solvingWire = v end, function() return not solvingWire end, 30)
        end,
        PinkSquash = function()
            local before = squashPasses
            local ok = runFlagged(function(v) squashingThings = v end, function() return squashPasses ~= before end, 60)
            squashingThings = false
            return ok
        end,
        Smoke = function()
            return runFlagged(function(v) smokingThings = v end, function() return not smokingThings end, 60)
        end,
        Painting = function()
            return runFlagged(function(v) solvingPaintings = v end, function() return not solvingPaintings end, 150)
        end,
        CheeseAltar = function()
            if bearThreat() and not dodgeBear() then return false end
            return solveAltar()
        end,
        Memory = function()
            for _ = 1, 3 do
                if not masteryFarming then return false end
                local _, _, aborted = solveMemoryGame(bearThreat)
                if not aborted then return true end
                if not dodgeBear() then return false end
            end
            return false
        end,
    }

    local ORDER = { "ColorCode", "Wire", "PinkSquash", "Smoke", "Painting", "CheeseAltar", "Memory" }

    while hubAlive do
        task.wait(0.1)
        if not masteryFarming then
            if masteryOwnsDance and currentDanceTrack then stopDance() end
            masteryOwnsDance = false
            releaseQuidz()
            continue
        end

        local team = player.Team
        if masteryQuidzWhenDead and team and team.Name == "Waiting" then
            if not farmingQuidz then
                farmingQuidz = true
                quidzOwned = true
            end
            task.wait(1)
            continue
        end
        releaseQuidz()

        if not team or team.Name ~= "Survivors" then
            table.clear(deferred)
            task.wait(3)
            continue
        end

        local fresh, later = {}, {}
        for _, name in ipairs(ORDER) do
            if puzzleActive(name) then
                if deferred[name] then later[#later + 1] = name else fresh[#fresh + 1] = name end
            end
        end
        table.sort(later, function(x, y) return deferred[x] < deferred[y] end)

        local name = fresh[1] or later[1]
        if not name then
            masteryDance()
            task.wait(3)
            continue
        end

        stopDance()
        if not fresh[1] and tick() - deferred[name] < 3 then
            task.wait(3 - (tick() - deferred[name]))
            if not masteryFarming then continue end
        end

        local ok = runners[name]()
        if ok and masteryFarming then
            masteryFarmed[name] = true
            deferred[name] = nil
        elseif masteryFarming then
            deferred[name] = tick()
        end
        task.wait(1)
    end
end)

