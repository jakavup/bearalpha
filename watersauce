task.spawn(function()
    local colorOrder = {
        Color3.fromRGB(255, 0,   0  ),
        Color3.fromRGB(255, 128, 0  ),
        Color3.fromRGB(255, 255, 0  ),
        Color3.fromRGB(0,   255, 0  ),
        Color3.fromRGB(0,   0,   255),
        Color3.fromRGB(255, 150, 255),
        Color3.fromRGB(128, 0,   128),
        Color3.fromRGB(0,   0,   0  ),
    }
    local function colorDist(a, b)
        return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B)
    end
    local function getClicksNeeded(targetColor)
        local best, bestIdx = math.huge, 1
        for i, c in ipairs(colorOrder) do
            local d = colorDist(targetColor, c)
            if d < best then best = d; bestIdx = i end
        end
        return bestIdx
    end

    local function readButtonColor(part)
        local ok, c = pcall(function() return part.Color end)
        if ok and typeof(c) == "Color3" then return c end
        return nil
    end

    local function isBlankColor(c)
        local mx = math.max(c.R, c.G, c.B)
        local mn = math.min(c.R, c.G, c.B)
        return mx < 0.15 or (mx - mn) < 0.12
    end

    local function getCurrentIndex(part)
        local c = readButtonColor(part)
        if not c or isBlankColor(c) then return 0 end
        local best, bestIdx = math.huge, 0
        for i = 1, #colorOrder - 1 do
            local d = colorDist(c, colorOrder[i])
            if d < best then best = d; bestIdx = i end
        end
        if best > 0.6 then return 0 end
        return bestIdx
    end

    local function clicksFrom(cur, target)
        if cur == 0 then return target end
        return (target - cur) % #colorOrder
    end

    while hubAlive do
        task.wait(0.05)
        if solvingCC then
            local ok, base = pcall(function()
                return workspace:WaitForChild("Map",10):WaitForChild("ColorCode",10):WaitForChild("Base",10)
            end)
