RunService:BindToRenderStep("Freecam", Enum.RenderPriority.Camera.Value + 2, function(dt)
    if not freecamEnabled then return end
    local mouse  = UserInputService:GetMouseDelta()
    freecamYaw   = freecamYaw   - mouse.X * 0.3
    freecamPitch = math.clamp(freecamPitch - mouse.Y * 0.3, -89, 89)
    local rot = CFrame.Angles(0, math.rad(freecamYaw), 0) * CFrame.Angles(math.rad(freecamPitch), 0, 0)
    local spd = FREECAM_SPEED
              * (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)   and 0.2 or 1)
              * (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) and 3   or 1)
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + rot.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move - rot.LookVector  end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move - rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + rot.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0, 1, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move - Vector3.new(0, 1, 0) end
    if move.Magnitude > 0 then freecamCF = freecamCF + move.Unit * spd * (dt * 60) end
    camera.CFrame = CFrame.new(freecamCF.Position) * rot
end)

hubConnect(RunService.RenderStepped, function(dt)
    local vp    = camera.ViewportSize
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    if bigHeadMode then
        local want = Vector3.new(bigHeadSize, bigHeadSize, bigHeadSize)
        for _, p in ipairs(Players:GetPlayers()) do
            local char = p.Character
            local head = char and char:FindFirstChild("Head")
            if head and head:IsA("BasePart") then
                if headOrig[head] == nil then headOrig[head] = head.Size end
                if head.Size ~= want then head.Size = want end
            end
        end
    end

    if spinEnabled and myHrp then
        spinAngle    = (spinAngle + spinSpeed * dt * 60) % 360
        myHrp.CFrame = CFrame.new(myHrp.Position) * CFrame.Angles(0, math.rad(spinAngle), 0)
    end

    if seizureMode and myHrp then
        local offset = Vector3.new(
            (math.random() - 0.5) * seizureIntensity,
            (math.random() - 0.5) * seizureIntensity,
            (math.random() - 0.5) * seizureIntensity
        )
        myHrp.CFrame = myHrp.CFrame + offset
    end

    if balloonRGB and balloonEnabled then
        balloonRGBHue = (balloonRGBHue + dt * balloonRGBSpeed) % 1
        for i, m in ipairs(balloonModels) do
            local b = m:FindFirstChildWhichIsA("Part")
            if b then
                local hue = (balloonRGBHue + (i - 1) * (1 / math.max(#balloonModels, 1))) % 1
                b.Color = Color3.fromHSV(hue, 1, 1)
            end
        end
    end

    for p, t in pairs(speedTrackers) do
        local showSpeed = playerSpeedLabels and espEnabled
        if t.bb then t.bb.Enabled = showSpeed end
        if not t.lbl or not showSpeed then
            t.lastPos = nil; t.accumTime = 0; t.accumDist = 0; continue
        end
        local char = p.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum then
            t.lastPos = nil; t.accumTime = 0; t.accumDist = 0; continue
        end
        local cur      = hrp.Position
        local grounded = hum:GetState() ~= Enum.HumanoidStateType.Jumping
                      and hum:GetState() ~= Enum.HumanoidStateType.Freefall
        if t.lastPos and grounded then
            local dx = cur.X - t.lastPos.X
            local dz = cur.Z - t.lastPos.Z
            t.accumDist = t.accumDist + math.sqrt(dx*dx + dz*dz)
            t.accumTime = t.accumTime + dt
        end
        t.lastPos = cur
        if t.accumTime >= 0.1 then
            t.lbl.Text  = math.floor(t.accumDist / t.accumTime) .. " u/s"
            t.accumTime = 0
            t.accumDist = 0
        end
    end

    local nearestBearDist = math.huge
    local nearestBearData = nil

    for p, objects in pairs(espObjects) do
        if p == player then continue end
        local char = p.Character
        if not char or not char.Parent then hideESPObjects(objects); continue end
        local hrp      = char:FindFirstChild("HumanoidRootPart")
        local head     = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not hrp or not head or not humanoid or humanoid.Health <= 0 then hideESPObjects(objects); continue end

        local isBear = p.Team ~= nil and p.Team.Name == "Bear"

        if not espEnabled then
            for _, obj in ipairs({
                objects.topLeft1, objects.topLeft2, objects.topRight1, objects.topRight2,
                objects.botLeft1, objects.botLeft2, objects.botRight1, objects.botRight2,
                objects.tracer, objects.name, objects.distance, objects.healthBg,
                objects.healthBar, objects.bearLine,
            }) do obj.Visible = false end
            continue
        end

        local hrpPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then hideESPObjects(objects); continue end

        local screenH, yTop, yBot
        if espStatic then
            screenH = -espStaticSize
            yTop    = math.floor(hrpPos.Y - espStaticSize / 2)
            yBot    = math.floor(hrpPos.Y + espStaticSize / 2)
        else
            local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.7, 0))
            local feetPos = camera:WorldToViewportPoint(hrp.Position  - Vector3.new(0, 3,   0))
            screenH = headPos.Y - feetPos.Y
            yTop    = math.floor(headPos.Y)
            yBot    = math.floor(feetPos.Y)
        end
        local screenW  = screenH * 0.5
        local x        = math.floor(hrpPos.X)
        local left     = math.floor(x - screenW / 2)
        local right    = math.floor(x + screenW / 2)
        local cw       = math.floor(screenW * cornerRatio)
        local ch       = math.floor(math.abs(screenH) * cornerRatio)
        local boxColor = isBear and Color3.new(1, 0.2, 0.2) or Color3.new(1, 1, 1)

        if isBear and myHrp then
            local d = (hrp.Position - myHrp.Position).Magnitude
            if d < nearestBearDist then
                nearestBearDist = d
                nearestBearData = { objects = objects, x = x, yBot = yBot }
            end
        end

        for _, k in ipairs({ "topLeft1","topLeft2","topRight1","topRight2","botLeft1","botLeft2","botRight1","botRight2" }) do
            objects[k].Visible = showBoxes
            objects[k].Color   = boxColor
            objects[k].Thickness = A.thick
        end

        objects.topLeft1.From  = Vector2.new(left,  yTop); objects.topLeft1.To   = Vector2.new(left  + cw, yTop)
        objects.topLeft2.From  = Vector2.new(left,  yTop); objects.topLeft2.To   = Vector2.new(left,       yTop + ch)
        objects.topRight1.From = Vector2.new(right, yTop); objects.topRight1.To  = Vector2.new(right - cw, yTop)
        objects.topRight2.From = Vector2.new(right, yTop); objects.topRight2.To  = Vector2.new(right,      yTop + ch)
        objects.botLeft1.From  = Vector2.new(left,  yBot); objects.botLeft1.To   = Vector2.new(left  + cw, yBot)
        objects.botLeft2.From  = Vector2.new(left,  yBot); objects.botLeft2.To   = Vector2.new(left,       yBot - ch)
        objects.botRight1.From = Vector2.new(right, yBot); objects.botRight1.To  = Vector2.new(right - cw, yBot)
        objects.botRight2.From = Vector2.new(right, yBot); objects.botRight2.To  = Vector2.new(right,      yBot - ch)

        objects.tracer.Color   = boxColor
        objects.tracer.Thickness = A.thick
        objects.tracer.Visible = showTracers
        objects.tracer.From    = Vector2.new(math.floor(vp.X / 2), math.floor(vp.Y))
        objects.tracer.To      = Vector2.new(x, yBot)

        objects.name.Visible   = showNames
        objects.name.Position  = Vector2.new(x, yTop - 16)
        objects.name.Text      = p.DisplayName
        objects.name.Size      = A.text

        if showDistances and myHrp then
            local dist = math.floor((hrp.Position - myHrp.Position).Magnitude)
            objects.distance.Visible  = true
            objects.distance.Position = Vector2.new(x, yTop - 28)
            objects.distance.Text     = dist .. " studs"
            objects.distance.Size     = math.max(A.text - 2, 8)
        else
            objects.distance.Visible = false
        end

        objects.bearLine.Visible = false

        local boxH    = math.max(math.abs(yBot - yTop), 1)
        local hPct    = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1)
        local hBarH   = math.floor(boxH * hPct)
        local hx      = left - 4
        local hpColor = hPct > 0.6 and Color3.new(0, 1, 0)
                     or (hPct > 0.3 and Color3.new(1, 1, 0) or Color3.new(1, 0, 0))
        objects.healthBg.Thickness  = A.thick + 0.5
        objects.healthBar.Thickness = A.thick + 0.5

        objects.healthBg.Visible  = showHealthBar
        objects.healthBg.From     = Vector2.new(hx, yTop)
        objects.healthBg.To       = Vector2.new(hx, yBot)
        objects.healthBar.Visible = showHealthBar
        objects.healthBar.From    = Vector2.new(hx, yBot)
        objects.healthBar.To      = Vector2.new(hx, yBot - hBarH)
        objects.healthBar.Color   = hpColor
    end

    if showNearestBearLine and nearestBearData then
        nearestBearData.objects.bearLine.Visible = true
        nearestBearData.objects.bearLine.Thickness = A.thick + 0.5
        nearestBearData.objects.bearLine.From    = Vector2.new(math.floor(vp.X / 2), math.floor(vp.Y / 2))
        nearestBearData.objects.bearLine.To      = Vector2.new(nearestBearData.x, nearestBearData.yBot)
    end

    for part, d in pairs(itemPool) do
        if not part or not part.Parent then hideItemDrawings(d); continue end
        local cat = d._cat
        if not itemEspEnabled or not categoryEnabled[cat]() then hideItemDrawings(d); continue end
        local pos, onScreen = camera:WorldToViewportPoint(part.Position)
        if not onScreen then hideItemDrawings(d); continue end
        local px = math.floor(pos.X)
        local py = math.floor(pos.Y)
        d.label.Visible  = itemShowNames
        d.label.Position = Vector2.new(px, py - 8)
        d.label.Text     = d._displayName
        d.label.Size     = math.max(A.text - 1, 8)
        d.tracer.Visible = itemShowTracers
        d.tracer.From    = Vector2.new(math.floor(vp.X / 2), math.floor(vp.Y))
        d.tracer.To      = Vector2.new(px, py)
        if itemShowBoxes then
            local sz   = part.Size
            local topW = camera:WorldToViewportPoint(part.Position + Vector3.new(0,  sz.Y / 2, 0))
            local botW = camera:WorldToViewportPoint(part.Position - Vector3.new(0,  sz.Y / 2, 0))
            local lefW = camera:WorldToViewportPoint(part.Position - Vector3.new(sz.X / 2, 0, 0))
            local ritW = camera:WorldToViewportPoint(part.Position + Vector3.new(sz.X / 2, 0, 0))
            local yT   = math.floor(topW.Y);  local yB  = math.floor(botW.Y)
            local xL   = math.floor(lefW.X);  local xR  = math.floor(ritW.X)
            local bW   = math.max(xR - xL, 4); local bH  = math.max(math.abs(yB - yT), 4)
            local cw2  = math.floor(bW * cornerRatioItem); local ch2 = math.floor(bH * cornerRatioItem)
            d.tl1.Visible = true; d.tl1.From = Vector2.new(xL, yT); d.tl1.To = Vector2.new(xL + cw2, yT)
            d.tl2.Visible = true; d.tl2.From = Vector2.new(xL, yT); d.tl2.To = Vector2.new(xL, yT + ch2)
            d.tr1.Visible = true; d.tr1.From = Vector2.new(xR, yT); d.tr1.To = Vector2.new(xR - cw2, yT)
            d.tr2.Visible = true; d.tr2.From = Vector2.new(xR, yT); d.tr2.To = Vector2.new(xR, yT + ch2)
            d.bl1.Visible = true; d.bl1.From = Vector2.new(xL, yB); d.bl1.To = Vector2.new(xL + cw2, yB)
