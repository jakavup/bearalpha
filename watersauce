local function stopDance()
    if currentDanceTrack then
        currentDanceTrack:Stop()
        currentDanceTrack:Destroy()
        currentDanceTrack = nil
    end
end

local function playDance()
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local pool = isR15() and danceIds.r15 or danceIds.r6
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://" .. pool[math.random(1, #pool)]
    local track = hum:LoadAnimation(anim)
    track.Looped   = true
    track.Priority = Enum.AnimationPriority.Action
    track:Play()
    currentDanceTrack = track
    return true
end

local function setupJumpBypass(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    hum.WalkSpeed = storedWalkSpeed
    hum.JumpPower = storedJumpPower
    hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping then
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local cur = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(cur.X, storedJumpPower, cur.Z)
            end
        end
    end)
end

