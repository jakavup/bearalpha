local function isR15()
    local char = player.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.RigType == Enum.HumanoidRigType.R15
end

local function getNearestSurvivor()
    local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    local nearest, nearestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        if p.Team and p.Team.Name == "Bear" then continue end
        local char = p.Character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not hrp or not hum or hum.Health <= 0 then continue end
        local d = (hrp.Position - myHrp.Position).Magnitude
        if d < nearestDist then nearestDist = d; nearest = p end
    end
    return nearest
end

local function getRageTarget()
    if rageAutoTarget then
        return getNearestSurvivor()
    elseif selectedTarget then
        return Players:FindFirstChild(selectedTarget)
    end
    return nil
end

local function findSafeSpotNear(part)
    local origin    = part.Position
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { player.Character }
    local offsets = {
        Vector3.new( 4, 10,  0), Vector3.new(-4, 10,  0),
        Vector3.new( 0, 10,  4), Vector3.new( 0, 10, -4),
        Vector3.new( 6, 10,  0), Vector3.new(-6, 10,  0),
        Vector3.new( 0, 10,  6), Vector3.new( 0, 10, -6),
        Vector3.new( 3, 10,  3), Vector3.new(-3, 10,  3),
        Vector3.new( 3, 10, -3), Vector3.new(-3, 10, -3),
    }
    for _, offset in ipairs(offsets) do
        local castOrigin = origin + offset
        local floorHit   = workspace:Raycast(castOrigin, Vector3.new(0, -25, 0), rayParams)
        if floorHit then
            local landPos   = floorHit.Position + Vector3.new(0, 3, 0)
            local toPartVec = origin - landPos
            local losHit    = workspace:Raycast(landPos, toPartVec, rayParams)
            local partDist  = toPartVec.Magnitude
            if not losHit or (losHit.Position - landPos).Magnitude >= partDist - 1 then
                return landPos
            end
        end
    end
    return origin + Vector3.new(0, 5, 0)
end

local function tryFireCD(hrp, part)
    local cd = part:FindFirstChildOfClass("ClickDetector")
    if not cd then
        for _, v in ipairs(part:GetDescendants()) do
            if v:IsA("ClickDetector") then cd = v; break end
        end
    end
    if cd then
        local ok1 = pcall(fireclickdetector, cd, 0)
        if ok1 then return true end
    end
    local ok2 = pcall(firetouchinterest, hrp, part, 0)
    if ok2 then task.wait(0.05); pcall(firetouchinterest, hrp, part, 1); return true end
    pcall(function() hrp.CFrame = part.CFrame + Vector3.new(0, 2, 0) end)
    task.wait(0.1)
    local ok3 = pcall(firetouchinterest, hrp, part, 0)
    if ok3 then pcall(firetouchinterest, hrp, part, 1); return true end
    pcall(function()
        for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
            if v:IsA("RemoteEvent") and (
                v.Name:lower():find("collect") or
                v.Name:lower():find("pickup")  or
                v.Name:lower():find("candy")   or
                v.Name:lower():find("interact")
            ) then
                v:FireServer(part)
            end
        end
    end)
    return false
end

