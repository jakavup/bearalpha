        if #NM.list == 0 then return end
        NM.running = true
        watchRoot(player:FindFirstChildOfClass("PlayerGui"))
        pcall(function() watchRoot(game:GetService("CoreGui")) end)
        pcall(function() if gethui then watchRoot(gethui()) end end)
        watchRoot(workspace)
    end

