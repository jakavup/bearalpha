            sound:Stop()
            sound.TimePosition = 0
            sound.SoundId = "rbxassetid://" .. entry.id
            log("loading " .. entry.id .. " ...")
            task.spawn(function()
                local t0 = os.clock()
                while not sound.IsLoaded and os.clock() - t0 < 8 do
                    if token ~= State.loadToken or State.dead then return end
                    task.wait(0.1)
                end
                if token ~= State.loadToken or State.dead then return end
                if not sound.IsLoaded or sound.TimeLength <= 0 then
                    log("failed: " .. entry.id .. " (private, removed or not audio)", true)
                    return
                end
                sound.Looped = State.loop
                sound:Play()
                log("playing [" .. i .. "] " .. entry.name)
            end)
        end

        local function nextIndex(dir)
            local n = #State.playlist
            if n == 0 then return nil end
            if State.shuffle and n > 1 then
                local r
                repeat r = math.random(1, n) until r ~= State.index
                return r
            end
            return ((State.index - 1 + dir) % n) + 1
        end

        track(sound.Ended:Connect(function()
            if State.loop or State.dead then return end
            local nxt = nextIndex(1)
            if nxt then playIndex(nxt) end
        end))

        local Commands = {}
        Commands.help = function()
            log("add <id>  play [n]  pause  resume  stop")
            log("next  prev  vol <0-100>  seek <sec>")
            log("loop  shuffle  list  rm <n>  clear  preset  cls  exit")
        end
        Commands.add = function(arg)
            local id = tonumber(arg)
            if not id then log("usage: add <id>", true) return end
            local entry = { id = math.floor(id), name = tostring(math.floor(id)) }
            State.playlist[#State.playlist + 1] = entry
            fetchName(entry)
            log("added [" .. #State.playlist .. "] " .. entry.id)
            if State.index == 0 then playIndex(#State.playlist) end
        end
        Commands.play = function(arg)
            local n = tonumber(arg)
            if n then playIndex(math.floor(n)) return end
            if current() then
                if sound.IsLoaded and not sound.IsPlaying then sound:Resume() log("resumed") else playIndex(State.index) end
            else
                log("playlist empty, add <id>", true)
            end
        end
        Commands.pause = function() sound:Pause() log("paused at " .. clock(sound.TimePosition)) end
        Commands.resume = function() sound:Resume() log("resumed") end
        Commands.stop = function() State.loadToken += 1 sound:Stop() log("stopped") end
        Commands.next = function() local n = nextIndex(1) if n then playIndex(n) end end
        Commands.prev = function() local n = nextIndex(-1) if n then playIndex(n) end end
        Commands.vol = function(arg)
            local v = tonumber(arg)
            if not v then log("volume " .. math.floor(State.volume * 100)) return end
            State.volume = math.clamp(v, 0, 100) / 100
            sound.Volume = State.volume
            log("volume " .. math.floor(State.volume * 100))
        end
        Commands.seek = function(arg)
            local v = tonumber(arg)
            if not v or not sound.IsLoaded then log("usage: seek <sec>", true) return end
            sound.TimePosition = math.clamp(v, 0, sound.TimeLength)
            log("seek " .. clock(sound.TimePosition))
        end
        Commands.loop = function()
            State.loop = not State.loop
            sound.Looped = State.loop
            log("loop " .. (State.loop and "on" or "off"))
        end
        Commands.shuffle = function()
            State.shuffle = not State.shuffle
            log("shuffle " .. (State.shuffle and "on" or "off"))
        end
        Commands.list = function()
            if #State.playlist == 0 then log("playlist empty") return end
            for i, e in ipairs(State.playlist) do
                log((i == State.index and "* " or "  ") .. "[" .. i .. "] " .. e.name)
            end
        end
        Commands.rm = function(arg)
            local n = tonumber(arg)
            if not n or not State.playlist[n] then log("usage: rm <n>", true) return end
            local e = table.remove(State.playlist, n)
            if n == State.index then
                State.loadToken += 1
                sound:Stop()
                State.index = 0
            elseif n < State.index then
                State.index -= 1
            end
            log("removed " .. e.name)
        end
        Commands.preset = function()
            for _, t in ipairs(PRESET) do
                State.playlist[#State.playlist + 1] = { id = t.id, name = t.name }
            end
            log("added " .. #PRESET .. " preset tracks")
        end
        Commands.clear = function()
            State.loadToken += 1
            sound:Stop()
            State.playlist, State.index = {}, 0
            log("playlist cleared")
        end
        Commands.cls = function()
            logBuf = {}
            logLabel.Text = ""
        end
        Commands.exit = function() env.__BA_MUSIC.Unload() end

        local function run(line)
            line = string.match(line, "^%s*(.-)%s*$")
            if line == "" then return end
            State.history[#State.history + 1] = line
            State.histPos = #State.history + 1
            log("> " .. line)
            local cmd, arg = string.match(line, "^(%S+)%s*(.*)$")
            local fn = Commands[string.lower(cmd)]
            if fn then
                local ok, err = pcall(fn, arg)
                if not ok then log("error: " .. tostring(err), true) end
            else
                log("unknown command: " .. cmd, true)
            end
        end

        track(input.FocusLost:Connect(function(enter)
            if not enter then return end
            local line = input.Text
            input.Text = ""
            run(line)
            task.defer(function() if not State.dead and State.open then input:CaptureFocus() end end)
        end))

        track(UserInputService.InputBegan:Connect(function(io)
            if State.dead then return end
            if io.KeyCode == TOGGLE_KEY then
                State.open = not State.open
                if State.open then
                    win.Visible = true
                    winScale.Scale = 0.95
                    tween(winScale, 0.2, { Scale = 1 })
                else
                    win.Visible = false
                    input:ReleaseFocus()
                end
            elseif input:IsFocused() and #State.history > 0 then
                if io.KeyCode == Enum.KeyCode.Up then
                    State.histPos = math.max(1, State.histPos - 1)
                    input.Text = State.history[State.histPos]
                    input.CursorPosition = #input.Text + 1
                elseif io.KeyCode == Enum.KeyCode.Down then
                    State.histPos = math.min(#State.history + 1, State.histPos + 1)
                    input.Text = State.history[State.histPos] or ""
                    input.CursorPosition = #input.Text + 1
                end
            end
        end))

        local dragging, dragStart, startPos
        track(titleBar.InputBegan:Connect(function(io)
            if io.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging, dragStart, startPos = true, io.Position, win.Position
            end
        end))
        track(UserInputService.InputChanged:Connect(function(io)
            if dragging and io.UserInputType == Enum.UserInputType.MouseMovement then
                local d = io.Position - dragStart
                win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end))
        track(UserInputService.InputEnded:Connect(function(io)
            if io.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
        end))

        local SPIN = { "|", "/", "-", "\\" }
        local spinK, spinT = 0, 0
        local rowBuf = table.create(VIS_ROWS)

        track(RunService.RenderStepped:Connect(function(dt)
            if State.dead or not State.open then return end
            local entry = current()
            local playing = sound.IsPlaying
            local loaded = sound.IsLoaded and sound.TimeLength > 0

            spinT += dt
            if spinT > 0.1 then spinT = 0 spinK += 1 end
            local status = playing and ">>" or (entry and not loaded and SPIN[(spinK % 4) + 1] .. " " or "||")
            nowLabel.Text = fit(status .. " " .. (entry and entry.name or "nothing queued"), 60)
            infoLabel.Text = string.format("track %d/%d   vol %3d%%   loop %s   shuffle %s",
                State.index, #State.playlist, math.floor(State.volume * 100),
                State.loop and "on " or "off", State.shuffle and "on " or "off")

            local loud = playing and sound.PlaybackLoudness or 0
            State.peak = math.max(State.peak * (1 - dt * 0.15), loud, 1)
            local level = loud / State.peak
            local now = os.clock()
            for c = 1, VIS_COLS do
                local x = (c - 1) / (VIS_COLS - 1)
                local shape = 1 - 0.45 * x
                local wobble = 0.55 + 0.45 * (math.noise(c * 0.37, now * 2.3) + 0.5)
                local target = math.clamp(level * shape * wobble, 0, 1)
                local cur = State.bars[c]
                if target > cur then cur += (target - cur) * math.min(dt * 25, 1)
                else cur -= math.min(cur, dt * 1.6) end
                State.bars[c] = cur
                if cur >= State.caps[c] then
                    State.caps[c] = cur
                    State.capHold[c] = 0.4
                else
                    State.capHold[c] -= dt
                    if State.capHold[c] <= 0 then State.caps[c] = math.max(0, State.caps[c] - dt * 0.8) end
                end
            end
            for r = VIS_ROWS, 1, -1 do
                local row = table.create(VIS_COLS)
                local lo = (r - 1) / VIS_ROWS
                local hi = r / VIS_ROWS
                for c = 1, VIS_COLS do
                    local v, cap = State.bars[c], State.caps[c]
                    if v >= hi then
                        row[c] = r > VIS_ROWS * 0.75 and "#" or (r > VIS_ROWS * 0.4 and "|" or ":")
                    elseif v > lo then
                        row[c] = "."
                    elseif cap > lo and cap <= hi and cap > 0.02 then
                        row[c] = "-"
                    else
                        row[c] = " "
                    end
                end
                rowBuf[VIS_ROWS - r + 1] = table.concat(row)
            end
            visLabel.Text = table.concat(rowBuf, "\n")

            if loaded then
                local pct = math.clamp(sound.TimePosition / sound.TimeLength, 0, 1)
                local fill = math.floor(pct * BAR_W + 0.5)
                local head = fill < BAR_W and ">" or ""
                progLabel.Text = string.format("[%s%s%s] %s / %s",
                    string.rep("=", math.max(fill - #head, 0)), head, string.rep("-", BAR_W - fill),
                    clock(sound.TimePosition), clock(sound.TimeLength))
            else
                progLabel.Text = "[" .. string.rep("-", BAR_W) .. "] --:-- / --:--"
            end
        end))

        local function Unload()
            if State.dead then return end
            State.dead = true
            State.loadToken += 1
            for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
            pcall(function() sound:Stop() sound:Destroy() end)
            pcall(function() gui:Destroy() end)
            env.__BA_MUSIC = nil
        end

        env.__BA_MUSIC = { Unload = Unload, Run = run }
        gui.Parent = parent
        winScale.Scale = 0.95
        tween(winScale, 0.25, { Scale = 1 })
        for _, t in ipairs(PRESET) do
            State.playlist[#State.playlist + 1] = { id = t.id, name = t.name }
        end
        log("music.exe ready. " .. #State.playlist .. " tracks loaded. type help")
    end

    local function stopMusicPlayer()
        local env = (getgenv and getgenv()) or _G
        if env.__BA_MUSIC and type(env.__BA_MUSIC.Unload) == "function" then
            pcall(env.__BA_MUSIC.Unload)
        end
    end

    T.grpFun:AddToggle("MusicPlayer", {
        Text = "Music Player + Visualizer", Default = false,
        Callback = function(v)
            if v then
                local ok, err = pcall(startMusicPlayer)
                if not ok then Library:Notify("Music player failed: " .. tostring(err), 4) end
            else
                stopMusicPlayer()
            end
        end,
    })

    if type(Library.OnUnload) == "function" then Library:OnUnload(stopMusicPlayer) end
end

do
    local V = {
        chamsOn = false,
        layered = false,
        style = "Fill",
        alpha = 0.5,
        pulse = false,
        rainbow = false,
        target = "Everyone",
        maxDist = 2500,
        budget = 30,
        visColor = Color3.fromRGB(80, 255, 120),
        hidColor = Color3.fromRGB(255, 60, 80),
        teamColors = false,
        bearColor = Color3.fromRGB(255, 60, 80),
        survColor = Color3.fromRGB(0, 230, 255),
        itemOn = false,
        itemCount = 8,
        itemDist = 300,
        selfOn = false,
        selfColor = Color3.fromRGB(0, 230, 255),
        selfMaterial = "Keep",
        nightOn = false,
        ccOn = false,
        sat = 0.3,
        con = 0.1,
        bri = 0,
        tint = Color3.new(1, 1, 1),
        bloomOn = false,
        thirdOn = false,
        thirdDist = 12,
        vigOn = false,
        vigRadius = 60,
        cham = {},
        itemCham = {},
        selfCham = nil,
        selfSaved = setmetatable({}, { __mode = "k" }),
        night = nil,
        cc = nil,
        bloom = nil,
        third = nil,
        vig = nil,
        warn = nil,
        conns = {},
        dead = false,
    }

    V.parent = (function()
        local ok, h = pcall(function() return gethui and gethui() end)
        return (ok and h) or game:GetService("CoreGui")
    end)()

    V.selfMaterials = {
        ForceField = Enum.Material.ForceField,
        Neon = Enum.Material.Neon,
        Glass = Enum.Material.Glass,
    }

    function V.safe(fn, ...)
        local ok, err = pcall(fn, ...)
        if not ok then return end
    end

    function V.pulseFactor(now)
        if V.pulse then return 0.65 + 0.35 * math.sin(now * 3) end
        return 1
    end

    function V.tone(color, now)
        if V.rainbow then return Color3.fromHSV((now * 0.2) % 1, 0.85, 1) end
        return color
    end

    function V.newHighlight(depth)
        local h = Instance.new("Highlight")
        h.DepthMode = depth
        h.Parent = V.parent
        return h
    end

    function V.paint(h, color, style, alpha, pulse)
        local a = alpha * pulse
        if style == "Fill" then
            h.FillColor, h.FillTransparency = color, 1 - a
            h.OutlineColor, h.OutlineTransparency = Color3.new(0, 0, 0), 0
        elseif style == "Glow" then
            h.FillColor, h.FillTransparency = color, 0.85
            h.OutlineColor, h.OutlineTransparency = color, (1 - pulse) * 0.6
        else
            h.FillColor, h.FillTransparency = color, 1
            h.OutlineColor, h.OutlineTransparency = color, (1 - pulse) * 0.6
        end
    end

    function V.killEntry(entry)
        if not entry then return end
        for _, h in pairs(entry) do
            pcall(function() h:Destroy() end)
        end
    end

    function V.isBear(p)
        return p.Team ~= nil and p.Team.Name == "Bear"
    end

    V.proxies = {}
    V.PROXY_PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg",
        "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg" }

    function V.proxyFor(char)
        local px = V.proxies[char]
        if px and px.Parent then return px end
        local model = Instance.new("Model")
        model.Name = HttpService:GenerateGUID(false)
        for _, name in ipairs(V.PROXY_PARTS) do
            local src = char:FindFirstChild(name)
            if src and src:IsA("BasePart") then
                local part = Instance.new("Part")
                part.Size = src.Size
                part.CFrame = src.CFrame
                part.Transparency = 0.99
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.Massless = true
                part.CastShadow = false
                part.Anchored = false
                part.Parent = model
                local w = Instance.new("WeldConstraint")
                w.Part0 = src
                w.Part1 = part
                w.Parent = part
            end
        end
        model.Parent = workspace
        V.proxies[char] = model
        return model
    end

    function V.dropProxies(keep)
        for char, model in pairs(V.proxies) do
            if not (keep and keep[char]) or not char.Parent then
                pcall(function() model:Destroy() end)
                V.proxies[char] = nil
            end
        end
    end

    function V.origin()
        local cam = workspace.CurrentCamera
        return cam and cam.CFrame.Position
    end

    function V.enemyStep(now)
        local want = {}
        local proxyKeep = {}
        if V.chamsOn then
            local origin = V.origin()
            local budget = V.budget - (V.selfOn and 1 or 0) - (V.itemOn and V.itemCount or 0)
            local per = V.layered and 2 or 1
            local cands = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player then
                    local isB = V.isBear(p)
                    local teamOk = V.target == "Everyone" or (V.target == "Bears" and isB) or (V.target == "Survivors" and not isB)
                    local char = p.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if teamOk and hrp and hum and hum.Health > 0 then
                        local d = origin and (hrp.Position - origin).Magnitude or 0
                        if d <= V.maxDist then
                            cands[#cands + 1] = { p = p, char = char, d = d, bear = isB }
                        end
                    end
                end
            end
            table.sort(cands, function(a, b) return a.d < b.d end)
            local pulse = V.pulseFactor(now)
            local used = 0
            for _, c in ipairs(cands) do
                if used + per > budget then break end
                used += per
                want[c.p] = true
                local entry = V.cham[c.p]
                if not entry or not entry.main or not entry.main.Parent then
                    V.killEntry(entry)
                    entry = { main = V.newHighlight(Enum.HighlightDepthMode.AlwaysOnTop) }
                    V.cham[c.p] = entry
                end
                if V.layered and (not entry.over or not entry.over.Parent) then
                    entry.over = V.newHighlight(Enum.HighlightDepthMode.Occluded)
                elseif not V.layered and entry.over then
                    pcall(function() entry.over:Destroy() end)
                    entry.over = nil
                end
                local target = c.char
                if c.bear then
                    target = V.proxyFor(c.char)
                    proxyKeep[c.char] = true
                end
                if entry.main.Adornee ~= target then entry.main.Adornee = target end
                if entry.over and entry.over.Adornee ~= target then entry.over.Adornee = target end
                local baseCol = V.visColor
                if V.teamColors then baseCol = c.bear and V.bearColor or V.survColor end
                local visC = V.tone(baseCol, now)
                local hidC = V.tone(V.hidColor, now)
                if V.layered then
                    V.paint(entry.main, hidC, V.style, V.alpha, pulse)
                    V.paint(entry.over, visC, V.style, V.alpha, pulse)
                else
                    V.paint(entry.main, visC, V.style, V.alpha, pulse)
                end
            end
        end
        for p, entry in pairs(V.cham) do
            if not want[p] then
                V.killEntry(entry)
                V.cham[p] = nil
            end
        end
        V.dropProxies(proxyKeep)
    end

    function V.itemStep(now)
        local want = {}
        if V.itemOn then
            local origin = V.origin()
            local cands = {}
            for part, d in pairs(itemPool) do
                if part and part.Parent and origin then
                    local dist = (part.Position - origin).Magnitude
                    if dist <= V.itemDist then
                        cands[#cands + 1] = { part = part, d = dist, color = d._color }
                    end
                end
            end
            table.sort(cands, function(a, b) return a.d < b.d end)
            local pulse = V.pulseFactor(now)
            for i = 1, math.min(#cands, V.itemCount) do
                local c = cands[i]
                want[c.part] = true
                local entry = V.itemCham[c.part]
                if not entry or not entry.main or not entry.main.Parent then
                    V.killEntry(entry)
                    entry = { main = V.newHighlight(Enum.HighlightDepthMode.AlwaysOnTop) }
                    V.itemCham[c.part] = entry
                end
                if entry.main.Adornee ~= c.part then entry.main.Adornee = c.part end
                V.paint(entry.main, V.tone(c.color or Color3.new(1, 1, 1), now), V.style, V.alpha, pulse)
            end
        end
        for part, entry in pairs(V.itemCham) do
            if not want[part] then
                V.killEntry(entry)
                V.itemCham[part] = nil
            end
        end
    end

    function V.selfRestore()
        for part, saved in pairs(V.selfSaved) do
            if part.Parent then
                pcall(function()
                    part.Color = saved.Color
                    part.Material = saved.Material
                end)
            end
            V.selfSaved[part] = nil
        end
    end

    function V.selfClear()
        if V.selfCham then
            pcall(function() V.selfCham:Destroy() end)
            V.selfCham = nil
        end
        if next(V.selfSaved) then V.selfRestore() end
    end

    function V.selfStep(now)
        local char = player.Character
        if not (V.selfOn and char) then
            V.selfClear()
            return
        end
        local color = V.tone(V.selfColor, now)
        if not V.selfCham or not V.selfCham.Parent then
            V.selfCham = V.newHighlight(Enum.HighlightDepthMode.Occluded)
        end
        if V.selfCham.Adornee ~= char then V.selfCham.Adornee = char end
        V.paint(V.selfCham, color, V.style, V.alpha, V.pulseFactor(now))
        local mat = V.selfMaterials[V.selfMaterial]
        if mat then
            for _, d in ipairs(char:GetDescendants()) do
                if d:IsA("BasePart") and not d:FindFirstAncestorOfClass("Tool") then
                    local saved = V.selfSaved[d]
                    if not saved then
                        saved = { Color = d.Color, Material = d.Material }
                        V.selfSaved[d] = saved
                    end
                    d.Color = color
                    d.Material = mat
                end
            end
        elseif next(V.selfSaved) then
            V.selfRestore()
        end
    end

    function V.vignetteStep()
        if not (V.vig and V.warn) then return end
        local on = false
        local myTeam = player.Team and player.Team.Name
        local cam = workspace.CurrentCamera
        local myHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if V.vigOn and myHrp and cam and myTeam ~= "Bear" then
            local best = math.huge
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= player and V.isBear(p) then
                    local char = p.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    local hum = char and char:FindFirstChildOfClass("Humanoid")
                    if hrp and hum and hum.Health > 0 then
                        local d = (hrp.Position - myHrp.Position).Magnitude
                        if d < best then best = d end
                    end
                end
            end
            if best <= V.vigRadius then
                on = true
                local vp = cam.ViewportSize
                local strength = math.clamp(1 - best / V.vigRadius, 0, 1)
                V.vig.Position = Vector2.new(0, 0)
                V.vig.Size = vp
                V.vig.Transparency = math.clamp(strength * 0.7, 0.05, 0.7)
                V.warn.Position = Vector2.new(vp.X / 2, 70)
                V.warn.Text = string.format("bear: %d studs", math.floor(best + 0.5))
            end
        end
        V.vig.Visible = on
        V.warn.Visible = on
    end

    function V.worldStep()
        local night = V.nightOn and not fullbrightEnabled
        if night then
            if not V.night then
                V.night = {
                    Brightness = lighting.Brightness,
                    ClockTime = lighting.ClockTime,
                    Ambient = lighting.Ambient,
                    OutdoorAmbient = lighting.OutdoorAmbient,
                    ExposureCompensation = lighting.ExposureCompensation,
                }
            end
            lighting.Brightness = 0.4
            lighting.ClockTime = 0
            lighting.Ambient = Color3.fromRGB(25, 30, 60)
            lighting.OutdoorAmbient = Color3.fromRGB(25, 30, 60)
            lighting.ExposureCompensation = -0.2
        elseif V.night then
            for k, v in pairs(V.night) do lighting[k] = v end
            V.night = nil
        end

        if V.ccOn then
            local cc = V.cc
            if not cc or not cc.Parent then
                cc = Instance.new("ColorCorrectionEffect")
                cc.Name = HttpService:GenerateGUID(false)
                cc.Parent = lighting
                V.cc = cc
            end
            cc.Saturation, cc.Contrast, cc.Brightness = V.sat, V.con, V.bri
            cc.TintColor = V.tint
        elseif V.cc then
            pcall(function() V.cc:Destroy() end)
            V.cc = nil
        end

        if V.bloomOn then
            local b = V.bloom
            if not b or not b.Parent then
                b = Instance.new("BloomEffect")
                b.Name = HttpService:GenerateGUID(false)
                b.Intensity, b.Size, b.Threshold = 1.2, 28, 0.85
                b.Parent = lighting
                V.bloom = b
            end
        elseif V.bloom then
            pcall(function() V.bloom:Destroy() end)
            V.bloom = nil
        end
    end

    function V.setZoom(minD, maxD)
        pcall(function() player.CameraMaxZoomDistance = maxD end)
        pcall(function() player.CameraMinZoomDistance = minD end)
        pcall(function() player.CameraMaxZoomDistance = maxD end)
    end

    function V.thirdRestore()
        if not V.third then return end
        local t = V.third
        V.third = nil
        V.setZoom(t.min, t.max)
        pcall(function() player.CameraMode = t.mode end)
    end

    function V.thirdStep()
        if V.thirdOn and not freecamEnabled then
            if not V.third then
                V.third = { min = player.CameraMinZoomDistance, max = player.CameraMaxZoomDistance, mode = player.CameraMode }
            end
            local d = V.thirdDist
            if player.CameraMinZoomDistance ~= d or player.CameraMaxZoomDistance ~= d then V.setZoom(d, d) end
            if player.CameraMode ~= Enum.CameraMode.Classic then
                pcall(function() player.CameraMode = Enum.CameraMode.Classic end)
            end
        else
            V.thirdRestore()
        end
    end

    function V.onRender()
        if V.dead then return end
        local now = os.clock()
        V.safe(V.enemyStep, now)
        V.safe(V.itemStep, now)
        V.safe(V.selfStep, now)
        V.safe(V.vignetteStep)
    end

    function V.onBeat()
        if V.dead then return end
        V.safe(V.worldStep)
        V.safe(V.thirdStep)
    end

    function V.cleanup()
        if V.dead then return end
        V.dead = true
        for _, c in ipairs(V.conns) do pcall(function() c:Disconnect() end) end
        V.conns = {}
        for _, e in pairs(V.cham) do V.killEntry(e) end
        for _, e in pairs(V.itemCham) do V.killEntry(e) end
        V.cham, V.itemCham = {}, {}
        V.dropProxies(nil)
        V.selfClear()
        V.thirdRestore()
        if V.night then
            for k, v in pairs(V.night) do lighting[k] = v end
            V.night = nil
        end
        if V.cc then pcall(function() V.cc:Destroy() end) end
        if V.bloom then pcall(function() V.bloom:Destroy() end) end
        if V.vig then pcall(function() V.vig:Remove() end) end
        if V.warn then pcall(function() V.warn:Remove() end) end
    end

    pcall(function()
