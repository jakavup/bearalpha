        for src, part in pairs(g.parts) do
            if src.Parent then part.CFrame = send * base:ToObjectSpace(src.CFrame) end
            local box = part:FindFirstChildOfClass("SelectionBox")
            if box then
                box.Color3 = color
                box.Transparency = 0.6 * (1 - wave)
                box.LineThickness = 0.03 + 0.04 * wave
            end
        end
    end

    hubConnect(RunService.Heartbeat, function()
        if not D.on then dropGhost(); return end
        local hrp = root()
        if not hrp then return end
        local cf = hrp.CFrame
        D.real = cf
        local send
        if D.mode == "Freeze" then
            local now = os.clock()
            if not D.frozen or (D.pulse and now - D.lastPulse >= D.pulseEvery) then
                D.frozen = cf
                D.lastPulse = now
            end
            send = D.frozen
        else
            local now = os.clock()
            local h = D.history
            h[#h + 1] = { now, cf }
            local cutoff = now - D.delay
            while #h > 1 and h[2][1] <= cutoff do table.remove(h, 1) end
            send = h[1][2]
        end
        pcall(updateGhost, hrp.Parent, hrp, send)
        hrp.CFrame = send
    end)

    RunService:BindToRenderStep(D.bind, Enum.RenderPriority.First.Value, function()
        if not D.real then return end
        local hrp = root()
        if hrp then hrp.CFrame = D.real end
        D.real = nil
    end)

    local function reset()
        D.frozen = nil
        D.history = {}
    end

    hubConnect(player.CharacterAdded, function()
        D.real = nil
        reset()
    end)

    T.grpFun:AddToggle("Desync", {
        Text = "Desync", Default = false,
        Callback = function(v)
            D.on = v
            reset()
            if not v and D.real then
                local hrp = root()
                if hrp then hrp.CFrame = D.real end
                D.real = nil
            end
        end,
    })
    T.grpFunSettings:AddDropdown("DesyncMode", {
        Text = "Desync Mode", Values = { "Freeze", "Delay" }, Default = 1,
        Callback = function(v) D.mode = v; reset() end,
    })
    T.grpFunSettings:AddToggle("DesyncGhost", {
        Text = "Show Server Position", Default = true,
        Callback = function(v) D.showGhost = v; if not v then dropGhost() end end,
    })
    T.grpFunSettings:AddToggle("DesyncPulse", {
        Text = "Freeze: Update Position", Default = false,
        Callback = function(v) D.pulse = v; D.lastPulse = os.clock() end,
    })
    T.grpFunSettings:AddSlider("DesyncPulseEvery", {
        Text = "Update Every (s)", Min = 0.2, Max = 10, Default = 2, Increment = 0.1, Rounding = 1,
        Callback = function(v) D.pulseEvery = v end,
    })
    T.grpFunSettings:AddSlider("DesyncDelay", {
        Text = "Desync Delay (s)", Min = 0.1, Max = 5, Default = 1, Increment = 0.1, Rounding = 1,
        Callback = function(v) D.delay = v end,
    })

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            D.on = false
            dropGhost()
            pcall(function() RunService:UnbindFromRenderStep(D.bind) end)
            if D.real then
                local hrp = root()
                if hrp then pcall(function() hrp.CFrame = D.real end) end
                D.real = nil
            end
        end)
    end
end

do
    local Q = { start = nil, startAt = os.clock(), roundStart = nil, lastRound = nil, labels = {} }

    local function readQuidz()
        local pg = player:FindFirstChildOfClass("PlayerGui")
        local gui = pg and pg:FindFirstChild("GameUI")
        local lh = gui and gui:FindFirstChild("LeftHandButtons")
        local md = lh and lh:FindFirstChild("MoneyDisplay")
        if not md then return nil end
        for _, d in ipairs(md:GetDescendants()) do
            if d:IsA("TextLabel") and type(d.Text) == "string" then
                local digits = string.gsub(d.Text, "[,%s]", "")
                local n = tonumber(string.match(digits, "^%-?%d+%.?%d*$") or "")
                if n then return n end
            end
        end
        return nil
    end

    local function fmt(n)
        if type(n) ~= "number" then return "?" end
        local sign = n < 0 and "-" or ""
        local digits = string.format("%d", math.floor(math.abs(n) + 0.5))
        local grouped = string.gsub(string.reverse(digits), "(%d%d%d)", "%1,")
        grouped = string.gsub(string.reverse(grouped), "^,", "")
        return sign .. grouped
    end

    local grpQ = T.tabFarming:AddRightGroupbox("Quidz Tracker")
    Q.labels.balance = grpQ:AddLabel("Balance: ?")
    Q.labels.session = grpQ:AddLabel("Session: +0")
    Q.labels.rate = grpQ:AddLabel("Per Hour: 0")
    Q.labels.round = grpQ:AddLabel("Last Round: -")
    grpQ:AddButton({
        Text = "Reset Session",
        Func = function()
            Q.start = readQuidz()
            Q.startAt = os.clock()
            Q.lastRound = nil
        end,
    })

    hubConnect(workspace.ChildAdded, function(c)
        if c.Name == "Map" then Q.roundStart = readQuidz() end
    end)
    hubConnect(workspace.ChildRemoved, function(c)
        if c.Name == "Map" and Q.roundStart then
            task.delay(2, function()
                local now = readQuidz()
                if now and Q.roundStart then Q.lastRound = now - Q.roundStart end
                Q.roundStart = nil
            end)
        end
    end)
    if workspace:FindFirstChild("Map") then Q.roundStart = readQuidz() end

    task.spawn(function()
        while hubAlive do
            local bal = readQuidz()
            if bal and not Q.start then
                Q.start = bal
                Q.startAt = os.clock()
            end
            local earned = (bal and Q.start) and (bal - Q.start) or 0
            local hours = math.max((os.clock() - Q.startAt) / 3600, 1 / 3600)
            pcall(function()
                Q.labels.balance:SetText("Balance: " .. fmt(bal))
                Q.labels.session:SetText("Session: " .. (earned >= 0 and "+" or "") .. fmt(earned))
                Q.labels.rate:SetText("Per Hour: " .. fmt(earned / hours))
                Q.labels.round:SetText("Last Round: " .. (Q.lastRound and ((Q.lastRound >= 0 and "+" or "") .. fmt(Q.lastRound)) or "-"))
            end)
            task.wait(1)
        end
    end)
end

do
    local P = { on = false, tracers = false, maxDist = 2000, pool = {} }
    local PUZZLES = {
        ColorCode = { label = "Color Code", color = Color3.fromRGB(255, 170, 0) },
        Wire = { label = "Wires", color = Color3.fromRGB(255, 230, 0) },
        CheeseAltar = { label = "Altar", color = Color3.fromRGB(255, 220, 120) },
        Memory = { label = "Memory", color = Color3.fromRGB(0, 200, 255), path = { "Base", "Detect" } },
        PinkSquash = { label = "Squash", color = Color3.fromRGB(255, 105, 180) },
        Smoke = { label = "Smoke", color = Color3.fromRGB(190, 190, 190) },
        Painting = { label = "Paintings", color = Color3.fromRGB(180, 120, 255) },
    }
    local EXTRAS = {
        ColorCode = { { label = "Color Code Answer", color = Color3.fromRGB(255, 255, 255), path = { "CodePositions", "Clue" } } },
        CheeseAltar = { { label = "Cheese Pickup", color = Color3.fromRGB(255, 240, 80), path = { "Items", "Item", "Detect" } } },
    }

    local function follow(inst, path)
        for _, name in ipairs(path) do
            inst = inst and inst:FindFirstChild(name)
        end
        return inst
    end

    local function anchorOf(inst)
        if inst:IsA("BasePart") then return inst.Position end
        local ok, cf = pcall(function() return inst:GetPivot() end)
        if ok and cf then return cf.Position end
        local part = inst:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position or nil
    end

    local function drawingsFor(inst, color)
        local d = P.pool[inst]
        if not d then
            d = {
                text = newDrawing("Text", { Size = 14, Center = true, Outline = true, Color = color, Visible = false, ZIndex = 8 }),
                line = newDrawing("Line", { Thickness = 1.2, Color = color, Visible = false, ZIndex = 7 }),
            }
            P.pool[inst] = d
        end
        return d
    end

    local function drop(inst)
        local d = P.pool[inst]
        if not d then return end
        pcall(function() d.text:Remove() end)
        pcall(function() d.line:Remove() end)
        P.pool[inst] = nil
    end

    local grpPuzzleEsp = T.tabESP:AddRightGroupbox("Puzzle ESP")
    grpPuzzleEsp:AddToggle("PuzzleESP", { Text = "Puzzle ESP", Default = false, Callback = function(v) P.on = v end })
    grpPuzzleEsp:AddToggle("PuzzleESPTracers", { Text = "Puzzle Tracers", Default = false, Callback = function(v) P.tracers = v end })
    grpPuzzleEsp:AddSlider("PuzzleESPDist", {
        Text = "Puzzle Max Distance", Min = 100, Max = 5000, Default = 2000, Increment = 100,
        Callback = function(v) P.maxDist = v end,
    })

    hubConnect(RunService.RenderStepped, function()
        local seen = {}
        local map = workspace:FindFirstChild("Map")
        if P.on and map then
            local cam = workspace.CurrentCamera
            local vp = cam.ViewportSize
            local origin = cam.CFrame.Position
            local function show(target, info)
                local pos = target and anchorOf(target)
                if not pos then return end
                seen[target] = true
                local d = drawingsFor(target, info.color)
                local dist = (pos - origin).Magnitude
                local sp, onScreen = cam:WorldToViewportPoint(pos)
                if onScreen and dist <= P.maxDist then
                    d.text.Visible = true
                    d.text.Size = A.text + 1
                    d.text.Position = Vector2.new(sp.X, sp.Y - 10)
                    d.text.Text = string.format("%s [%d]", info.label, math.floor(dist + 0.5))
                    d.line.Visible = P.tracers
                    d.line.Thickness = A.thick
                    d.line.From = Vector2.new(vp.X / 2, vp.Y)
                    d.line.To = Vector2.new(sp.X, sp.Y)
                else
                    d.text.Visible = false
                    d.line.Visible = false
                end
            end
            for _, child in ipairs(map:GetChildren()) do
                local info = PUZZLES[child.Name]
                if info and not masteryFarmed[child.Name] then
                    show(info.path and follow(child, info.path) or child, info)
                    for _, extra in ipairs(EXTRAS[child.Name] or {}) do
                        show(follow(child, extra.path), extra)
                    end
                end
            end
        end
        for inst in pairs(P.pool) do
            if not seen[inst] then drop(inst) end
        end
    end)

    if type(Library.OnUnload) == "function" then
        Library:OnUnload(function()
            P.on = false
            for inst in pairs(P.pool) do drop(inst) end
        end)
    end
end

do
    local genv = (getgenv and getgenv()) or _G
    local ROOT = "BAHub"
    local DIR = ROOT .. "/configs"
    local AUTO = ROOT .. "/autoload.txt"
    local SKIP = { AsciiUI = true, WebhookUrl = true, WebhookWatcher = true }
    local hasFs = type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function"

    local function toggles() return Library.Toggles or genv.Toggles or {} end
    local function options() return Library.Options or genv.Options or {} end

    local function ensureDirs()
        if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return end
        if not isfolder(ROOT) then makefolder(ROOT) end
        if not isfolder(DIR) then makefolder(DIR) end
    end

    local function cleanName(n)
        n = string.match(n or "", "^%s*(.-)%s*$")
        n = string.gsub(n, "[^%w%-_ ]", "")
        return n
    end

    local function serialize()
        local data = { toggles = {}, options = {} }
        for id, t in pairs(toggles()) do
            if not SKIP[id] and type(t) == "table" and type(t.Value) == "boolean" then
                data.toggles[id] = t.Value
            end
        end
        for id, o in pairs(options()) do
            if not SKIP[id] and type(o) == "table" then
                local ty, v = o.Type, o.Value
                if ty == "ColorPicker" and typeof(v) == "Color3" then
                    data.options[id] = { type = ty, hex = v:ToHex(), alpha = o.Transparency or 0 }
                elseif ty == "KeyPicker" then
                    data.options[id] = { type = ty, key = tostring(v), mode = o.Mode }
                elseif ty == "Slider" or ty == "Input" then
                    data.options[id] = { type = ty, value = v }
                elseif ty == "Dropdown" then
                    data.options[id] = { type = ty, value = v, multi = o.Multi and true or false }
                end
            end
        end
        return HttpService:JSONEncode(data)
    end

    local function apply(json)
        local ok, data = pcall(function() return HttpService:JSONDecode(json) end)
        if not ok or type(data) ~= "table" then return false end
        local opts = options()
        for id, entry in pairs(data.options or {}) do
            local o = opts[id]
            if o and type(entry) == "table" then
                pcall(function()
                    if entry.type == "ColorPicker" and entry.hex then
                        o:SetValueRGB(Color3.fromHex(entry.hex), entry.alpha)
                    elseif entry.type == "KeyPicker" and entry.key then
                        o:SetValue({ entry.key, entry.mode })
                    elseif entry.value ~= nil then
                        o:SetValue(entry.value)
                    end
                end)
            end
        end
        local tgs = toggles()
        for id, v in pairs(data.toggles or {}) do
            local t = tgs[id]
            if t and type(v) == "boolean" and t.Value ~= v then
                pcall(function() t:SetValue(v) end)
            end
        end
        return true
    end

    local function list()
        local out = {}
        if type(listfiles) ~= "function" or type(isfolder) ~= "function" or not isfolder(DIR) then return out end
        for _, f in ipairs(listfiles(DIR)) do
            local name = string.match(f, "([^/\\]+)%.json$")
            if name then out[#out + 1] = name end
        end
        table.sort(out)
        return out
    end

    local function path(name) return DIR .. "/" .. name .. ".json" end

    local tabConfigs = Window:AddTab("Configs", "save")
    local grpCfg = tabConfigs:AddLeftGroupbox("Configs")
    local grpAuto = tabConfigs:AddRightGroupbox("Autoload")
    local nameInput = ""
    local selected = nil
    local dropdown, autoLabel

    local function refresh()
        local names = list()
        pcall(function() dropdown:SetValues(names) end)
        if selected and not table.find(names, selected) then selected = nil end
        pcall(function() dropdown:SetValue(selected) end)
    end

    local function autoText()
        if hasFs and isfile(AUTO) then
            local n = readfile(AUTO)
            if n ~= "" then return "Autoload: " .. n end
        end
        return "Autoload: none"
    end

    grpCfg:AddInput("CfgName", {
        Text = "Config Name", Default = "", Placeholder = "my config",
        Callback = function(v) nameInput = v end,
    })
    grpCfg:AddButton({
        Text = "Create / Overwrite",
        Func = function()
            if not hasFs then Library:Notify("Executor has no file functions.", 3); return end
            local n = cleanName(nameInput ~= "" and nameInput or selected)
            if n == "" then Library:Notify("Enter a config name.", 3); return end
            ensureDirs()
            local ok, err = pcall(writefile, path(n), serialize())
            if not ok then Library:Notify("Save failed: " .. tostring(err), 4); return end
            selected = n
            refresh()
            Library:Notify("Saved " .. n .. ".", 3)
        end,
    })
    dropdown = grpCfg:AddDropdown("CfgList", {
        Text = "Configs", Values = list(), Default = nil, AllowNull = true,
        Callback = function(v) selected = v end,
    })
    grpCfg:AddButton({
        Text = "Load",
        Func = function()
            if not selected then Library:Notify("Pick a config.", 3); return end
            if not (hasFs and isfile(path(selected))) then Library:Notify("Config file missing.", 3); refresh(); return end
            local ok = apply(readfile(path(selected)))
            Library:Notify(ok and ("Loaded " .. selected .. ".") or "Config is corrupted.", 3)
        end,
    })
    grpCfg:AddButton({
        Text = "Delete",
        Func = function()
            if not selected then Library:Notify("Pick a config.", 3); return end
            if type(delfile) ~= "function" then Library:Notify("Executor has no delfile.", 3); return end
            local n = selected
            pcall(delfile, path(n))
            if hasFs and isfile(AUTO) and readfile(AUTO) == n then pcall(writefile, AUTO, "") end
            selected = nil
            refresh()
            pcall(function() autoLabel:SetText(autoText()) end)
            Library:Notify("Deleted " .. n .. ".", 3)
        end,
    })
    grpCfg:AddButton({ Text = "Refresh List", Func = refresh })

    autoLabel = grpAuto:AddLabel(autoText())
    grpAuto:AddButton({
        Text = "Set Selected As Autoload",
        Func = function()
            if not selected then Library:Notify("Pick a config.", 3); return end
            if not hasFs then return end
            ensureDirs()
            pcall(writefile, AUTO, selected)
            pcall(function() autoLabel:SetText(autoText()) end)
        end,
    })
    grpAuto:AddButton({
        Text = "Clear Autoload",
        Func = function()
            if hasFs and isfile(AUTO) then pcall(writefile, AUTO, "") end
            pcall(function() autoLabel:SetText(autoText()) end)
        end,
    })

    if hasFs then
        ensureDirs()
        task.defer(function()
            if not isfile(AUTO) then return end
            local n = readfile(AUTO)
            if n ~= "" and isfile(path(n)) and apply(readfile(path(n))) then
                Library:Notify("Autoloaded " .. n .. ".", 3)
            end
        end)
    end
end

