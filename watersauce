                solvingCC = false; Library:Notify("Could not find ColorCode.", 3)
            else
                local btns = base:FindFirstChild("Buttons")
                if not btns then
                    solvingCC = false; Library:Notify("No Buttons found.", 3)
                else
                    local clueOk, clueFrame = pcall(function()
                        return workspace:WaitForChild("Map",10)
                            :WaitForChild("ColorCode",10)
                            :WaitForChild("CodePositions",10)
                            :WaitForChild("Clue",10)
                            :WaitForChild("Note",10)
                            :WaitForChild("Frame",10)
                    end)
                    if not clueOk or not clueFrame then
                        solvingCC = false; Library:Notify("Could not find clue frame.", 3)
                    else
                        local parts = {
                            btns:WaitForChild("1",10), btns:WaitForChild("2",10),
                            btns:WaitForChild("3",10), btns:WaitForChild("4",10),
                        }
                        for _, part in ipairs(parts) do
                            local cd = getCD(part)
                            if cd then cd.MaxActivationDistance = 1e11 end
                        end
                        teleportTo(parts[1]); task.wait(0.5)
                        local targets = {}
                        for i = 1, 4 do
                            local label = clueFrame:FindFirstChild(tostring(i))
                            if label and label:IsA("TextLabel") then
                                targets[i] = getClicksNeeded(label.TextColor3)
                            else
                                targets[i] = 1
                            end
                        end
                        for i, part in ipairs(parts) do
                            if not solvingCC then break end
                            local cd = getCD(part)
                            if cd then
                                local cur  = getCurrentIndex(part)
                                local need = clicksFrom(cur, targets[i])
                                for _ = 1, need do
                                    if not solvingCC then break end
                                    fireclickdetector(cd, 10); task.wait(0.15)
                                end
                            end
                        end
                        solvingCC = false
                        Library:Notify("Color code solved.", 3)
                    end
                end
            end
        end
    end
end)

