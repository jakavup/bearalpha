    local menuGuis = {}
    local function isText(o)
        return o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox")
    end
    local function applyText(o)
        if not isText(o) or o.TextScaled then return end
        if not baseSize[o] then baseSize[o] = o.TextSize end
        o.TextSize = math.max(6, math.floor(baseSize[o] * scale + 0.5))
